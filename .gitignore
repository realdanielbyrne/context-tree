# ── dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# ── build output ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
packages/*/dist/

# ── test / coverage ─────────────────────────────────────────────────────────
coverage/
.vitest/
*.lcov
.nyc_output/

# ── secrets & local config ──────────────────────────────────────────────────
.env
.env.*
!.env.example
context-tree.config.local.json
local.settings.json

# ── runtime data (L0–L4 are all regenerable or local-only) ──────────────────
# Default on-disk store for a task tree: trace.jsonl + blobs/ + SQLite + views.
.context-tree/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Eval runs write results + recorded completions; fixtures ARE committed.
eval/results/
eval/.cache/
eval-resumption/results/
eval-resumption/.cache/
# Downloaded benchmark datasets are local-only; the fixtures under eval/test/fixtures ARE committed.
eval/scenarios/
!eval/fixtures/
!eval-resumption/fixtures/

# ── operational data (never committed) ────────────────────────────────────
# Real Vista/ERP extracts and their analysis outputs live here for local work.
# This repo is a public-facing npm project; company data must never enter it.
docs/*.csv
analysis/
*.emem.csv

# ── agent scratch ───────────────────────────────────────────────────────────
# subagent-driven-development workspace: ledger, briefs, review packages.
.superpowers/
.claude/worktrees/
.claude/settings.local.json

# ── graft ───────────────────────────────────────────────────────────────────
# graft's local graph cache — regenerable, not committed (run `graft build`).
# `.ignore` re-admits this tree to ripgrep so the cards stay greppable.
graft/

# ── python (analysis/) ──────────────────────────────────────────────────────
# Data-analysis venv for the scripts under analysis/. Recreate with:
#   python3 -m venv .venv && .venv/bin/pip install -r analysis/requirements.txt
.venv/
__pycache__/
*.pyc

# ── editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
