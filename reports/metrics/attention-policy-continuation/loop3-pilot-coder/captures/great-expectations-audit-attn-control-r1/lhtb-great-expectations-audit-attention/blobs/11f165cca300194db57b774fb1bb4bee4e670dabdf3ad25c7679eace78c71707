']\n        order_amount = order['amount_cents']\n        order_status = order['status']\n        \n        # Get settled payments and processed refunds for this order\n        settled_payment_amount = payments_by_order.get(order_id, 0)\n        processed_refund_amount = refunds_by_order.get(order_id, 0)\n        \n        # Calculate net collected amount\n        net_collected = settled_payment_amount - processed_refund_amount\n        \n        # Determine balance status\n        balanced = False\n        \n        if order_status == 'completed':\n            # Completed orders are balanced when net collected equals order amount\n            balanced = net_collected == order_amount\n        elif order_status == 'pending':\n            # Pending orders are balanced when net collected is between 0 and order amount\n            balanced = 0 <= net_collected <= order_amount\n        elif order_status == 'canceled':\n            # Canceled orders are balanced when net collected is exactly 0\n            balanced = net_collected == 0\n        \n        reconciliation_results.append({\n            \"order_id\": order_id,\n            \"order_status\": order_status,\n            \"order_amount_cents\": int(order_amount),\n            \"settled_payment_cents\": int(settled_payment_amount),\n            \"processed_refund_cents\": int(processed_refund_amount),\n            \"net_collected_cents\": int(net_collected),\n            \"balanced\": balanced\n        })\n    \n    # Calculate totals\n    total_orders = len(reconciliation_results)\n    total_balanced = sum(1 for r in reconciliation_results if r['balanced'])\n    \n    return {\n        \"total_orders\": total_orders,\n        \"balanced_orders\": total_balanced,\n        \"unbalanced_orders\": total_orders - total_balanced,\n        \"results\": reconciliation_results\n    }\n\ndef run_great_expectations_validation(\n    customers_df: pd.DataFrame,\n    orders_df: pd.DataFrame,\n    payments_df: pd.DataFrame,\n   