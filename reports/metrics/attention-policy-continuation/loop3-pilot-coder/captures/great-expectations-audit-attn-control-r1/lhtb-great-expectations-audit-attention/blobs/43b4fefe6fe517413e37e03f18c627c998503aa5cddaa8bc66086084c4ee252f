idx, 'refund_id'],\\n            'reason': 'duplicate_primary_key'\\n        })\\n    \\n    # Remove duplicates keeping first occurrence\\n    df_clean = df.drop_duplicates(subset=['refund_id'], keep='first')\\n    \\n    return df_clean, quarantine_records\\n\\ndef run_reconciliation(\\n    orders_df: pd.DataFrame,\\n    payments_df: pd.DataFrame,\\n    refunds_df: pd.DataFrame\\n) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Perform reconciliation of orders against payments and refunds.\\\"\\\"\\\"\\n    # Group payments and refunds by order_id\\n    payments_by_order = payments_df.groupby('order_id')['amount_cents'].sum().to_dict()\\n    refunds_by_order = refunds_df.groupby('order_id')['amount_cents'].sum().to_dict()\\n    \\n    # Prepare reconciliation results\\n    reconciliation_results = []\\n    \\n    for _, order in orders_df.iterrows():\\n        order_id = order['order_id']\\n        order_amount = order['amount_cents']\\n        order_status = order['status']\\n        \\n        # Get settled payments and processed refunds for this order\\n        settled_payment_amount = payments_by_order.get(order_id, 0)\\n        processed_refund_amount = refunds_by_order.get(order_id, 0)\\n        \\n        # Calculate net collected amount\\n        net_collected = settled_payment_amount - processed_refund_amount\\n        \\n        # Determine balance status\\n        balanced = False\\n        \\n        if order_status == 'completed':\\n            # Completed orders are balanced when net collected equals order amount\\n            balanced = net_collected == order_amount\\n        elif order_status == 'pending':\\n            # Pending orders are balanced when net collected is between 0 and order amount\\n            balanced = 0 <= net_collected <= order_amount\\n        elif order_status == 'canceled':\\n            # Canceled orders are balanced when net collected is exactly 0\\n            balanced = net_collected == 0\\n        \\n        reconciliation_results.append({\\n            \\\"order_id\\\": order_id,\\n            \\\"order_status\\\": order_status,\\n            \\\"order_amount_cents\\\": int(order_amount),\\n            \\\"settled_payment_cents\\\": int(settled_payment_amount),\\n            \\\"processed_refund_cents\\\": int(processed_refund_amount),\\n            \\\"net_collected_cents\\\": int(net_collected),\\n            \\\"balanced\\\": balanced\\n        })\\n    \\n    # Calculate totals\\n    total_orders = len(reconciliation_results)\\n    total_balanced = sum(1 for r in reconciliation_results if r['balanced'])\\n    \\n    return {\\n        \\\"total_orders\\\": total_orders,\\n        \\\"balanced_orders\\\": total_balanced,\\n        \\\"unbalanced_orders\\\": total_orders - total_balanced,\\n        \\\"results\\\": reconciliation_results\\n    }\\n\\ndef run_great_expectations_validation(\\n    customers_df: pd.DataFrame,\\n    orders_df: pd.DataFrame,\\n    payments_df: pd.DataFrame,\\n    refunds_df: pd.DataFrame,\\n    expectations_config: dict\\n) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Run Great Expectations validation on cleaned data.\\\"\\\"\\\"\\n    \\n    # Create a temporary directory for GX context\\n    import tempfile\\n    import os\\n    \\n    with tempfile.TemporaryDirectory() as temp_dir:\\n        # Initialize a simple GX context\\n        context = DataContext()\\n        \\n        # Create expectation suites for each dataset\\n        datasets = {\\n            'customers': customers_df,\\n            'orders': orders_df,\\n            'payments': payments_df,\\n            'refunds': refunds_df\\n        }\\n        \\n        all_expectation_results = {}\\n        \\n        # Process each dataset according to expectations\\n        for dataset_name, df in datasets.items():\\n            if dataset_name not in expectations_config['datasets']:\\n                continue\\n                \\n            # Create expectation suite for this dataset\\n            expectation_suite = ExpectationSuite(name=f\\\"{dataset_name}_suite\\\")\\n            \\n            # Add expectations based on configuration\\n            dataset_config = expectations_config['datasets'][dataset_name]\\n            \\n            # Add primary key validation\\n            if 'primary_key' in dataset_config:\\n                pk_col = dataset_config['primary_key']\\n                expectation_suite.add_expectation(\\n                    gx.expectations.ExpectColumnValuesToBeUnique(column=pk_col)\\n                )\\n                \\n            # Add column expectations\\n            if 'columns' in dataset_config:\\n                for col_name, col_config in dataset_config['columns'].items():\\n                    if 'not_null' in col_config and col_config['not_null']:\\n                        expectation_suite.add_expectation(\\n                            gx.expectations.ExpectColumnValuesToNotBeNull(column=col_name)\\n                        )\\n                        \\n                    if 'regex' in col_config:\\n                        expectation_suite.add_expectation(\\n                            gx.expectations.ExpectColumnMatchRegex(column=col_name, regex=col_config['regex'])\\n                        )\\n                        \\n                    if 'in_set' in col_config:\\n                        expectation_suite.add_expectation(\\n                            gx.expectations.ExpectColumnValuesToBeInSet(column=col_name, value_set=col_config['in_set'])\\n                        )\\n                        \\n                    if 'min' in col_config:\\n                        expectation_suite.add_expectation(\\n                            gx.expectations.ExpectColumnValuesToBeBetween(column=col_name, min_value=col_config['min'])\\n                        )\\n            \\n            # Validate the dataset\\n            validator = context.get_validator(\\n                batch_request=gx.get_batch_request(\\n             