def normalize_string(s: str) -> str:
    """Normalize string values by stripping whitespace and converting to lowercase."""
    if pd.isna(s):
        return s
    return str(s).strip().lower()

def normalize_id(id_val: str, prefix: str) -> str:
    """Normalize ID values to match expected format."""
    if pd.isna(id_val):
        return id_val
    # Remove whitespace and ensure proper prefix
    normalized = str(id_val).strip().upper()
    if not normalized.startswith(prefix):
        normalized = f"{prefix}{normalized.lstrip('0')}"
    return normalized

def parse_date(date_str: str) -> str:
    """Parse various date formats into ISO format."""
    if pd.isna(date_str):
        return date_str
    
    date_str = str(date_str).strip()
    
    # Common date formats
    formats = [
        "%Y-%m-%d",       # ISO format
        "%m/%d/%Y",       # MM/DD/YYYY
        "%Y/%m/%d",       # YYYY/MM/DD
        "%d-%m-%Y",       # DD-MM-YYYY
    ]
    
    for fmt in formats:
        try:
            parsed = datetime.strptime(date_str, fmt)
            return parsed.strftime("%Y-%m-%d")
        except ValueError:
            continue
    
    return date_str  # Return original if parsing fails

def parse_amount(amount_str: str) -> int:
    """Parse amount strings into integer cents."""
    if pd.isna(amount_str):
        return amount_str
    
    # Remove currency symbols, commas, and whitespace
    amount_str = str(amount_str).strip()
    
    # Remove common currency symbols and commas
    amount_str = re.sub(r'[^\d.-]', '', amount_str)
    
    try:
        # Convert to float and then to cents
        amount = float(amount_str)
        return int(round(amount * 100))
    except ValueError:
        return amount_str  # Return original if conversion fails

def validate_and_clean_customers(df: pd.DataFrame) -> Tuple[pd.DataFrame, List[Dict]]:
    """Clean and validate customers data."""
    quarantine_records = []
    
    # Normalize column names
    df.columns = [col.strip().lower() for col in df.columns]
    
    # Validate and clean customer_id
    df['customer_id'] = df['customer_id'].apply(lambda x: normalize_id(x, 'C'))
    
    # Validate and clean email
    df['email'] = df['email'].apply(normalize_string)
    
    # Validate and clean tier
    df['tier'] = df['tier'].apply(normalize_string)
    valid_tiers = {'bronze', 'silver', 'gold', 'enterprise'}
    df['tier'] = df['tier'].apply(lambda x: x if x in valid_tiers else 'unknown')
    
    # Validate and clean signup_date
    df['signup_date'] = df['signup_date'].apply(parse_date)
    
    # Validate and clean country
    df['country'] = df['country'].apply(normalize_string)
    valid_countries = {'us', 'ca', 'gb', 'fr'}
    df['country'] = df['country'].apply(lambda x: x.upper() if x in valid_countries else 'unknown')
    
    # Check for required fields
    for idx, row in df.iterrows():
        # Check for null customer_id
        if pd.isna(row['customer_id']) or row['customer_id'] == '':
            quarantine_records.append({
                'dataset': 'customers',
                'row_number': idx + 2,  # +2 because header is row 1
                'record_id': 'N/A',
                'reason': 'invalid_customer_id'
            })
            continue
            
        # Check for invalid email
        email_pattern = r'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
        if not re.match(email_pattern, row['email']):
            quarantine_records.append({
                'dataset': 'customers',
                'row_number': idx + 2,
                'record_id': row['customer_id'],
                'reason': 'invalid_email'
            })
            
        # Check for invalid tier
        if row['tier'] == 'unknown':
            quarantine_records.append({
                'dataset': 'customers',
                'row_number': idx + 2,
                'record_id': row['customer_id'],
                'reason': 'invalid_tier'
            })
            
        # Check for invalid country
        if row['country'] == 'unknown':
            quarantine_records.append({
                'dataset': 'customers',
                'row_number': idx + 2,
                'record_id': row['customer_id'],
                'reason': 'invalid_country'
            })
            
        # Check for invalid signup_date
        if not re.match(r'^\d{4}-\d{2}-\d{2}$', row['signup_date']):
            quarantine_records.append({
                'dataset': 'customers',
                'row_number': idx + 2,
                'record_id': row['customer_id'],
                'reason': 'invalid_date'
            })
    
    # Check for duplicate customer_ids (keep first, quarantine others)
    duplicated = df.duplicated(subset=['customer_id'], keep='first')
    for idx in df[duplicated].index:
        quarantine_records.append({
            'dataset': 'customers',
            'row_number': idx + 2,
            'record_id': df.loc[idx, 'customer_id'],
            'reason': 'duplicate_primary_key'
        })
    
    # Remove duplicates keeping first occurrence
    df_clean = df.drop_duplicates(subset=['customer_id'], keep='first')
    
    return df_clean, quarantine_records

