{"text":"","model":"z-ai/glm-5.3-flash","usageKnown":true,"usage":{"input":5154,"output":6464,"cacheRead":0,"cacheWrite":0},"toolCalls":[{"id":"call_bba78c6bb0d847f2ab23c47b","name":"write_file","input":{"path":"/app/src/dq_audit/audit.py","content":"\"\"\"Great Expectations powered data quality and reconciliation audit pipeline.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom collections import Counter, OrderedDict\nfrom datetime import datetime\nfrom pathlib import Path\n\nimport pandas as pd\nimport yaml\n\nDATASETS = [\"customers\", \"orders\", \"payments\", \"refunds\"]\nCOLUMNS = {\n    \"customers\": [\"customer_id\", \"name\", \"email\", \"tier\", \"signup_date\", \"country\"],\n    \"orders\": [\"order_id\", \"customer_id\", \"order_date\", \"status\", \"amount_cents\", \"currency\"],\n    \"payments\": [\"payment_id\", \"order_id\", \"payment_date\", \"status\", \"amount_cents\", \"method\", \"currency\"],\n    \"refunds\": [\"refund_id\", \"order_id\", \"refund_date\", \"status\", \"amount_cents\", \"reason\", \"currency\"],\n}\nPK = {\"customers\": \"customer_id\", \"orders\": \"order_id\", \"payments\": \"payment_id\", \"refunds\": \"refund_id\"}\nFK = {\"orders\": \"customer_id\", \"payments\": \"order_id\", \"refunds\": \"order_id\"}\nRAW_AMOUNT_COL = \"amount_cents\"\nUPPER_COLS = {\"customer_id\", \"order_id\", \"payment_id\", \"refund_id\", \"country\", \"currency\"}\nLOWER_COLS = {\"email\", \"tier\", \"status\", \"method\", \"reason\"}\nDATE_COLS = {\"signup_date\", \"order_date\", \"payment_date\", \"refund_date\"}\nEMAIL_RE = re.compile(r\"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$\")\nDATE_FORMATS = [\"%Y-%m-%d\", \"%m/%d/%Y\", \"%Y/%m/%d\", \"%d-%m-%Y\", \"%m-%d-%Y\"]\n\n\n# ---------------------------------------------------------------- normalization\ndef clean_cell(value):\n    if value is None or (isinstance(value, float) and pd.isna(value)):\n        return None\n    return re.sub(r\"\\s+\", \" \", str(value)).strip()\n\n\ndef normalize_date(value):\n    v = clean_cell(value)\n    if v is None:\n        return None, None\n    for fmt in DATE_FORMATS:\n        try:\n            return datetime.strptime(v, fmt).strftime(\"%Y-%m-%d\"), None\n        except ValueError:\n            continue\n    return None, \"invalid_date\"\n\n\ndef normalize_amount(value):\n    v = clean_cell(value)\n    if v is None or v == \"\":\n        return None, \"invalid_amount\"\n    s = v.replace(\",\", \"\").replace(\"$\", \"\").strip()\n    if re.fullmatch(r\"-?\\d+\", s):\n        cents = int(s)\n        return (cents, None) if cents >= 1 else (None, \"invalid_amount\")\n    try:\n        cents = round(float(s) * 100)\n    except ValueError:\n        return None, \"invalid_amount\"\n    return (cents, None) if cents >= 1 else (None, \"invalid_amount\")\n\n\ndef normalize_row(dataset: str, raw: dict) -> tuple[dict | None, list[str]]:\n    \"\"\"Normalize one raw row. Returns (row, reasons); row may be partial.\"\"\"\n    row: dict = {}\n    reasons: list[str] = []\n    for col in COLUMNS[dataset]:\n        src = \"amount\" if col == \"amount_cents\" else col\n        v = clean_cell(raw.get(src))\n        if col in UPPER_COLS:\n            v = v.upper() if v is not None else None\n        elif col in LOWER_COLS:\n            v = v.lower() if v is not None else None\n        row[col] = v\n    for col in DATE_COLS:\n        parsed, err = normalize_date(row.get(col))\n        row[col] = parsed\n        if err:\n            reasons.append(err)\n    if \"amount_cents\" in row:\n        cents, err = normalize_amount(raw.get(\"amount\"))\n        row[\"amount_cents\"] = cents\n        if err:\n            reasons.append(err)\n    return row, reasons\n\n\ndef validate_row(dataset: str, row: dict, rules: dict, seen_pks: set) -> list[str]:\n    reasons: list[str] = []\n    rule = rules[dataset]\n    pk = PK[dataset]\n    pkv = row.get(pk)\n    if pkv is None or pkv == \"\":\n        reasons.append(\"invalid_primary_key\")\n    elif not re.fullmatch(rule[\"columns\"][pk][\"regex\"], pkv):\n        reasons.append(\"invalid_primary_key\")\n    elif pkv in seen_pks:\n        reasons.append(\"duplicate_primary_key\")\n    colrules = rule[\"columns\"]\n    for col, cr in colrules.items():\n        val = row.get(col)\n        if cr.get(\"not_null\") and (val is None or val == \"\"):\n            reasons.append(f\"missing_{col}\")\n            continue\n        if val in (None, \"\"):\n            continue\n        if col == \"email\" and not EMAIL_RE.match(val):\n            reasons.append(\"invalid_email\")\n        if \"in_set\" in cr and val not in cr[\"in_set\"]:\n            if col in (\"status\", \"reason\", \"method\"):\n                reasons.append(\"invalid_status\" if col == \"status\" else f\"invalid_{col}\")\n            elif col == \"currency\":\n                reasons.append(\"invalid_currency\")\n            elif col == \"country\":\n                reasons.append(\"invalid_country\")\n            elif col == \"tier\":\n                reasons.append(\"invalid_tier\")\n            else:\n                reasons.append(f\"invalid_{col}\")\n        if \"min\" in cr and isinstance(val, int) and val < cr[\"min\"]:\n            reasons.append(\"invalid_amount\")\n    return reasons\n\n\ndef clean_dataset(name: str, df_raw: pd.DataFrame, rules: dict, parent_keys: set | None,\n                  order_amounts: dict | None) -> tuple[pd.DataFrame, list[dict], dict]:\n    rule = rules[\"datasets\"][name]\n    pk = PK[name]\n    seen: set = set()\n    kept: list[dict] = []\n    quarantine: list[dict] = []\n    keep_index: list[int] = []\n    for i, raw in df_raw.to_dict(orient=\"index\").items():\n        raw = {k: v for k, v in raw.items()}\n        row, reasons = normalize_row(name, raw)\n        record_id = row.get(pk) or \"\"\n        reasons = reasons + validate_row(name, row, rule, seen)\n        if parent_keys is not None and reasons == [] or (parent_keys is not None and not [r for r in reasons if r not in ()]):\n            fk = FK.get(name)\n            if fk and row.get(fk) not in parent_keys and \"invalid_primary_key\" not in reasons and \"duplicate_primary_key\" not in reasons:\n                reasons.append(\"unknown_customer\" if name == \"orders\" else \"unknown_order\")\n        if name == \"refunds\" and order_amounts is not None:\n            if row.get(\"status\") == \"processed\" and row.get(\"order_id\") in order_amounts:\n                if (row.get(\"amount_cents\") or 0) > order_amounts[row[\"order_id\"]]:\n                    reasons.append(\"refund_exceeds_order_amount\")\n        row_number = int(i) + 2  # 1-based data row, header is line 1\n        if reasons:\n            quarantine.append({\n                \"dataset\": name,\n                \"row_number\": row_number,\n                \"record_id\": record_id,\n                \"reason\": \";\".join(OrderedDict.fromkeys(reasons)),\n            })\n        else:\n            seen.add(row[pk])\n            kept.append(row)\n            keep_index.append(row_number)\n    df = pd.DataFrame(kept, columns=COLUMNS[name]) if kept else pd.DataFrame(columns=COLUMNS[name])\n    return df, quarantine, {\"kept_rows\": keep_index}\n\n\n# ---------------------------------------------------------------- expectations\ndef build_expectations(name: str, rules: dict) -> list[dict]:\n    out = []\n    for col, cr in rules[\"datasets\"][name][\"columns\"].items():\n        if cr.get(\"not_null\"):\n            out.append({\"expectation_type\": \"expect_column_values_to_not_be_null\", \"kwargs\": {\"column\": col}})\n        if cr.get(\"unique\"):\n            out.append({\"expectation_type\": \"expect_column_values_to_be_unique\", \"kwargs\": {\"column\": col}})\n        if cr.get(\"regex\"):\n            out.append({\"expectation_type\": \"expect_column_values_to_match_regex\",\n                        \"kwargs\": {\"column\": col, \"regex\": cr[\"regex\"]}})\n        if cr.get(\"in_set\"):\n            out.append({\"expectation_type\": \"expect_column_values_to_be_in_set\",\n                        \"kwargs\": {\"column\": col, \"value_set\": cr[\"in_set\"]}})\n        if \"min\" in cr:\n            out.append({\"expectation_type\": \"expect_column_values_to_be_between\",\n                        \"kwargs\": {\"column\": col, \"min_value\": cr[\"min\"], \"strict_min\": True}})\n    return out\n\n\ndef run_gx_validation(cleaned: dict, rules: dict):\n    \"\"\"Validate cleaned dataframes with Great Expectations (fluent ephemeral API).\"\"\"\n    import great_expectations as gx\n\n    context = gx.get_context(mode=\"ephemeral\")\n    datasource = context.sources.add_pandas(name=\"audit_datasource\")\n    results = {}\n    all_pass = True\n    for name in DATASETS:\n        asset = datasource.add_dataframe_asset(name=f\"{name}_asset\")\n        batch = asset.build_batch_request(dataframe=cleaned[name])\n        suite = context.add_expectation_suite(expectation_suite_name=f\"{name}_suite\")\n        validator = context.get_validator(batch_request=batch, expectation_suite=suite)\n        exp_results = []\n        for exp in build_expectations(name, rules):\n            method = getattr(validator, exp[\"expectation_type\"])\n            res = method(**exp[\"kwargs\"])\n            exp_results.append({\n                \"expectation_type\": exp[\"expectation_type\"],\n                \"column\": exp[\"kwargs\"].get(\"column\"),\n                \"kwargs\": {k: v for k, v in exp[\"kwargs\"].items() if k != \"column\"},\n                \"success\": bool(res.success),\n                \"unexpected_count\": int(res.result.get(\"unexpected_count\", 0) or 0),\n            })\n            if not res.success:\n                all_pass = False\n        validator.save_expectation_suite(discard_failed_expectations=False)\n        checkpoint = context.add_or_update_checkpoint(name=f\"{name}_checkpoint\", validations=[{\n            \"batch_request\": batch, \"expectation_suite_name\": f\"{name}_suite\"}])\n        checkpoint_result = checkpoint.run()\n        results[name] = {\n            \"rows\": int(len(cleaned[name])),\n            \"columns\": COLUMNS[name],\n            \"expectations_total\": len(exp_results),\n            \"expectations_passed\": sum(1 for e in exp_results if e[\"success\"]),\n            \"checkpoint_success\": bool(checkpoint_result.success),\n            \"expectation_results\": exp_results,\n        }\n        all_pass = all_pass and checkpoint_result.success\n\n    cross_table = []\n    for ct in rules.get(\"cross_table\", []):\n        left_vals = set(cleaned[ct[\"left_dataset\"]][ct[\"left_column\"]].dropna())\n        right_vals = set(cleaned[ct[\"right_dataset\"]][ct[\"right_column\"]].dropna())\n        orphans = sorted(left_vals - right_vals)\n        passed = not orphans\n        all_pass = all_pass and passed\n        cross_table.append({\n            \"name\": ct[\"name\"],\n            \"left_dataset\": ct[\"left_dataset\"],\n            \"left_column\": ct[\"left_column\"],\n            \"right_dataset\": ct[\"right_dataset\"],\n            \"right_column\": ct[\"right_column\"],\n            \"orphan_values\": orphans,\n            \"success\": passed,\n        })\n    return results, cross_table, all_pass\n\n\n# ---------------------------------------------------------------- reconciliation\ndef reconcile(orders: pd.DataFrame, payments: pd.DataFrame, refunds: pd.DataFrame) -> dict:\n    settled = payments[payments[\"status\"] == \"settled\"].groupby(\"order_id\")[\"amount_cents\"].sum().to_dict()\n    processed = refunds[refunds[\"status\"] == \"processed\"].groupby(\"order_id\")[\"amount_cents\"].sum().to_dict()\n    rows = []\n    for r in orders.to_dict(orient=\"records\"):\n        oid = r[\"order_id\"]\n        amt = int(r[\"amount_cents\"])\n        sp = int(settled.get(oid, 0))\n        pr = int(processed.get(oid, 0))\n        net = sp - pr\n        status = r[\"status\"]\n        if status == \"completed\":\n            balanced = net == amt\n        elif status == \"pending\":\n            balanced = 0 <= net <= amt\n        else:  # canceled\n            balanced = net == 0\n        rows.append({\n            \"order_id\": oid,\n            \"order_status\": status,\n            \"order_amount_cents\": amt,\n            \"settled_payment_cents\": sp,\n            \"processed_refund_cents\": pr,\n            \"net_collected_cents\": net,\n            \"balanced\": bool(balanced),\n        })\n    balanced_rows = [x for x in rows if x[\"balanced\"]]\n    return {\n        \"totals\": {\n            \"total_orders\": len(rows),\n            \"balanced_orders\": len(balanced_rows),\n            \"unbalanced_orders\": len(rows) - len(balanced_rows),\n            \"total_order_amount_cents\": sum(x[\"order_amount_cents\"] for x in rows),\n            \"total_settled_payment_cents\": sum(x[\"settled_payment_cents\"] for x in rows),\n            \"total_processed_refund_cents\": sum(x[\"processed_refund_cents\"] for x in rows),\n            \"total_net_collected_cents\": sum(x[\"net_collected_cents\"] for x in rows),\n        },\n        \"orders\": rows,\n    }\n\n\n# ---------------------------------------------------------------- reports\ndef write_validation_report(dataset_results, cross_table, gx_pass, recon, cleaned, quarantine, rules_path, dataset_name):\n    quarantine_counts = Counter(q[\"reason\"] for q in quarantine)\n    failed = []\n    for name in DATASETS:\n        for e in dataset_results[name][\"expectation_results\"]:\n            if not e[\"success\"]:\n                failed.append({\"dataset\": name, **e})\n    recon_checks = [\n        {\"name\": \"completed_orders_balanced\",\n         \"success\": all(x[\"balanced\"] for x in recon[\"orders\"] if x[\"order_status\"] == \"completed\")},\n        {\"name\": \"pending_orders_net_between_zero_and_amount\",\n         \"success\": all(x[\"balanced\"] for x in recon[\"orders\"] if x[\"order_status\"] == \"pending\")},\n        {\"name\": \"canceled_orders_net_zero\",\n         \"success\": all(x[\"balanced\"] for x in recon[\"orders\"] if x[\"order_status\"] == \"canceled\")},\nxq   ]\n    overall = bool(gx_pass and all(c[\"success\"] for c in recon_checks) and all(c[\"success\"] for c in cross_table))\n    return {\n        \"metadata\": {\n            \"dataset\": dataset_name,\n            \"rules_path\": str(rules_path),\n            \"gx_version\": __import__(\"great_expectations\").__version__,\n        },\n        \"dataset_row_counts\": {name: int(len(cleaned[name])) for name in DATASETS},\n        \"datasets\": dataset_results,\n        \"cross_table_checks\": cross_table,\n        \"reconciliation_checks\": recon_checks,\n        \"quarantine_reason_counts\": dict(sorted(quarantine_counts.items())),\n        \"failed_expectations\": failed,\n        \"overall_pass\": overall,\n    }\n\n\ndef write_summary(validation, recon, counts, quarantine, path: Path):\n    qcounts = Counter(q[\"reason\"] for q in quarantine)\n    lines = [\n        \"# Data Quality Audit Summary\",\n        \"## Overall\",\n        f\"- Overall pass: **{validation['overall_pass']}**\",\n        f\"- Expectation suites passing: {sum(1 for n in DATASETS if validation['datasets'][n]['checkpoint_success'])}/{len(DATASETS)}\",\n        f\"- Cross-table checks passed: {sum(1 for c in validation['cross_table_checks'] if c['success'])}/{len(validation['cross_table_checks'])}\",\n        f\"- Rows quarantined: {len(quarantine)}\",\n        \"\",\n        \"## Dataset Counts\",\n    ]\n    for name in DATASETS:\n        exp = validation[\"datasets\"][name]\n        lines.append(f\"- {name}: {counts[name]} cleaned rows, {exp['expectations_passed']}/{exp['expectations_total']} expectations passed\")\n    lines += [\"\", \"## Quarantine Reasons\"]\n    if qcounts:\n        for reason, n in sorted(qcounts.items()):\n            lines.append(f\"- {reason}: {n}\")\n    else:\n        lines.append(\"- none\")\n    t = recon[\"totals\"]\n    lines += [\n        \"\",\n        \"## Reconciliation\",\n        f\"- Total orders: {t['total_orders']}\",\n        f\"- Balanced orders: {t['balanced_orders']}\",\n        f\"- Unbalanced orders: {t['unbalanced_orders']}\",\n        f\"- Total order amount: {t['total_order_amount_cents']} cents\",\n        f\"- Total settled payments: {t['total_settled_payment_cents']} cents\",\n        f\"- Total processed refunds: {t['total_processed_refund_cents']} cents\",\n        f\"- Total net collected: {t['total_net_collected_cents']} cents\",\n        \"\",\n        \"## Failed Expectations\",\n    ]\n    if validation[\"failed_expectations\"]:\n        for f in validation[\"failed_expectations\"]:\n            lines.append(f\"- {f['dataset']}: {f['expectation_type']} on {f['column']}\")\n    else:\n        lines.append(\"- none\")\n    path.write_text(\"\\n\".join(lines) + \"\\n\")\n\n\n# ---------------------------------------------------------------- entry point\ndef run_audit(config_path: Path, out_dir: Path) -> None:\n    config = yaml.safe_load(config_path.read_text())\n    rules = yaml.safe_load(Path(config[\"rules_path\"]).read_text())\n    out_dir.mkdir(parents=True, exist_ok=True)\n\n    raw = {\n        \"customers\": pd.read_csv(config[\"customers_path\"], dtype=str, keep_default_na=False),\n        \"orders\": pd.read_csv(config[\"orders_path\"], dtype=str, keep_default_na=False),\n        \"payments\": pd.read_csv(config[\"payments_path\"], dtype=str, keep_default_na=False),\n        \"refunds\": pd.read_csv(config[\"refunds_path\"], dtype=str, keep_default_na=False),\n    }\n\n    cleaned, quarantine = {}, []\n    # pass 1: customers (no parent)\n    cleaned[\"customers\"], q, _ = clean_dataset(\"customers\", raw[\"customers\"], rules, None, None)\n    quarantine += q\n    cust_ids = set(cleaned[\"customers\"][\"customer_id\"])\n    # pass 2: orders need order amounts for refund checks; clean orders first\n    cleaned[\"orders\"], q, _ = clean_dataset(\"orders\", raw[\"orders\"], rules, cust_ids, None)\n    quarantine += q\n    order_ids = set(cleaned[\"orders\"][\"order_id\"])\n    order_amounts = dict(zip(cleaned[\"orders\"][\"order_id\"], cleaned[\"orders\"][\"amount_cents\"].astype(int)))\n    cleaned[\"payments\"], q, _ = clean_dataset(\"payments\", raw[\"payments\"], rules, order_ids, None)\n    quarantine += q\n    cleaned[\"refunds\"], q, _ = clean_dataset(\"refunds\", raw[\"refunds\"], rules, order_ids, order_amounts)\n    quarantine += q\n\n    # write cleaned csvs\n    for name in DATASETS:\n        cleaned[name].to_csv(out_dir / f\"cleaned_{name}.csv\", index=False)\n    pd.DataFrame(quarantine, columns=[\"dataset\", \"row_number\", \"record_id\", \"reason\"]).to_csv(\n        out_dir / \"quarantine_report.csv\", index=False)\n\n    # GX validation\n    dataset_results, cross_table, gx_pass = run_gx_validation(cleaned, rules)\n\n    recon = reconcile(cleaned[\"orders\"], cleaned[\"payments\"], cleaned[\"refunds\"])\n    validation = write_validation_report(\n        dataset_results, cross_table, gx_pass, recon, cleaned, quarantine,\n        config[\"rules_path\"], config.get(\"dataset\", \"audit\"))\n\n    (out_dir / \"reconciliation_report.json\").write_text(json.dumps(recon, indent=2) + \"\\n\")\n    (out_dir / \"validation_report.json\").write_text(json.dumps(validation, indent=2) + \"\\n\")\n    counts = {name: int(len(cleaned[name])) for name in DATASETS}\n    write_summary(validation, recon, counts, quarantine, out_dir / \"audit_summary.md\")\n    print(f\"Audit complete. overall_pass={validation['overall_pass']} quarantined={len(quarantine)}\")\n"}}],"stopReason":"tool_calls"}