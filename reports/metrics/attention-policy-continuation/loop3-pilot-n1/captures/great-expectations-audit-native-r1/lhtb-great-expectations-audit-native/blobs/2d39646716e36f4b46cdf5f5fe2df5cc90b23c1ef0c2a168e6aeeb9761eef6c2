from __future__ import annotations

import argparse
from pathlib import Path

from .audit import run_audit


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the data quality audit pipeline.")
    sub = parser.add_subparsers(dest="command")
    run = sub.add_parser("run")
    run.add_argument("--config", default="configs/public_audit.yml")
    run.add_argument("--out-dir", default="outputs")
    args = parser.parse_args()
    if args.command != "run":
        parser.print_help()
        raise SystemExit(2)
    run_audit(Path(args.config), Path(args.out_dir))


if __name__ == "__main__":
    main()
