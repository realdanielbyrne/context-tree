payment_date: {not_null: true, regex: \"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\"}\n      status: {not_null: true, in_set: [settled, pending, failed]}\n      amount_cents: {not_null: true, min: 1}\n      method: {not_null: true, in_set: [card, ach, wire, paypal]}\n      currency: {not_null: true, in_set: [USD, CAD, GBP, EUR]}\n  refunds:\n    primary_key: refund_id\n    columns:\n      refund_id: {not_null: true, unique: true, regex: \"^R[0-9]{3}$\"}\n      order_id: {not_null: true, regex: \"^O[0-9]{3}$\"}\n      refund_date: {not_null: true, regex: \"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\"}\n      status: {not_null: true, in_set: [processed, pending, rejected]}\n      amount_cents: {not_null: true, min: 1}\n      reason: {not_null: true, in_set: [customer_request, duplicate, fraud, price_adjustment]}\n      currency: {not_null: true, in_set: [USD, CAD, GBP, EUR]}\ncross_table:\n  - {name: orders_customer_id_referential, left_dataset: orders, left_column: customer_id, right_dataset: customers, right_column: customer_id}\n  - {name: payments_order_id_referential, left_dataset: payments, left_column: order_id, right_dataset: orders, right_column: order_id}\n  - {name: refunds_order_id_referential, left_dataset: refunds, left_column: order_id, right_dataset: orders, right_column: order_id}\n\n--- stderr ---\n"},{"role":"user","content":"[tool_result run_command]\n[call] {\"id\":\"call_589dd0956b744b69b0a92b5a\",\"name\":\"run_command\",\"input\":{\"command\":\"cd /app && cat src/dq_audit/cli.py src/dq_audit/__init__.py src/dq_audit/audit.py experiments/run_audit_suite.py\"},\"isError\":false}\n[output] --- exit 0 ---\n--- stdout ---\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom .audit import run_audit\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Run the data quality audit pipeline.\")\n    sub = parser.add_subparsers(dest=\"command\")\n    run = sub.add_parser(\"run\")\n    run.add_argument(\"--config\", default=\