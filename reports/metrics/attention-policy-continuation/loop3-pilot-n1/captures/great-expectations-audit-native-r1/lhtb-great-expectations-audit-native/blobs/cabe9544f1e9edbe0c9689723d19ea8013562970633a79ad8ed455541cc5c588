t] --- exit 0 ---\n--- stdout ---\nName: great-expectations\nVersion: 0.18.21\nSummary: Always know what to expect from your data.\n0.18.21 2.2.3 6.0.2\n/app/src/dq_audit/__init__.py\n\n--- stderr ---\n"},{"role":"assistant","content":""},{"role":"user","content":"[tool_result write_file]\n[call] {\"id\":\"call_bba78c6bb0d847f2ab23c47b\",\"name\":\"write_file\",\"input\":{\"path\":\"/app/src/dq_audit/audit.py\",\"content\":\"\\\"\\\"\\\"Great Expectations powered data quality and reconciliation audit pipeline.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport re\\nfrom collections import Counter, OrderedDict\\nfrom datetime import datetime\\nfrom pathlib import Path\\n\\nimport pandas as pd\\nimport yaml\\n\\nDATASETS = [\\\"customers\\\", \\\"orders\\\", \\\"payments\\\", \\\"refunds\\\"]\\nCOLUMNS = {\\n    \\\"customers\\\": [\\\"customer_id\\\", \\\"name\\\", \\\"email\\\", \\\"tier\\\", \\\"signup_date\\\", \\\"country\\\"],\\n    \\\"orders\\\": [\\\"order_id\\\", \\\"customer_id\\\", \\\"order_date\\\", \\\"status\\\", \\\"amount_cents\\\", \\\"currency\\\"],\\n    \\\"payments\\\": [\\\"payment_id\\\", \\\"order_id\\\", \\\"payment_date\\\", \\\"status\\\", \\\"amount_cents\\\", \\\"method\\\", \\\"currency\\\"],\\n    \\\"refunds\\\": [\\\"refund_id\\\", \\\"order_id\\\", \\\"refund_date\\\", \\\"status\\\", \\\"amount_cents\\\", \\\"reason\\\", \\\"currency\\\"],\\n}\\nPK = {\\\"customers\\\": \\\"customer_id\\\", \\\"orders\\\": \\\"order_id\\\", \\\"payments\\\": \\\"payment_id\\\", \\\"refunds\\\": \\\"refund_id\\\"}\\nFK = {\\\"orders\\\": \\\"customer_id\\\", \\\"payments\\\": \\\"order_id\\\", \\\"refunds\\\": \\\"order_id\\\"}\\nRAW_AMOUNT_COL = \\\"amount_cents\\\"\\nUPPER_COLS = {\\\"customer_id\\\", \\\"order_id\\\", \\\"payment_id\\\", \\\"refund_id\\\", \\\"country\\\", \\\"currency\\\"}\\nLOWER_COLS = {\\\"email\\\", \\\"tier\\\", \\\"status\\\", \\\"method\\\", \\\"reason\\\"}\\nDATE_COLS = {\\\"signup_date\\\", \\\"order_date\\\", \\\"payment_date\\\", \\\"refund_date\\\"}\\nEMAIL_RE = re.compile(r\\\"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}$\\\")\\nDATE_FORMATS = [\\\"%Y-%m-%d\\\", \\\"%m/%d/%Y\\\", \\\"%Y/%m/%d\\\", \\\"%d-%m-%Y\\\", \\\"%m-%d-%Y\\\"]\\n\\n\\n# ---------------------------------------------------------------- normalization\\ndef clean_cell(value):\\n    if value is None or (isinstance(value, float) and pd.isna(value)):\\n        return None\\n    return re.sub(r\\\"\\\\s+\\\", \\\" \\\", str(value)).strip()\\n\\n\\ndef normalize_date(value):\\n    v = clean_cell(value)\\n    if v is None:\\n        return None, None\\n    for fmt in DATE_FORMATS:\\n        try:\\n            return datetime.strptime(v, fmt).strftime(\\\"%Y-%m-%d\\\"), None\\n        except ValueError:\\n            continue\\n    return None, \\\"invalid_date\\\"\\n\\n\\ndef normalize_amount(value):\\n    v = clean_cell(value)\\n    if v is None or v == \\\"\\\":\\n        return None, \\\"invalid_amount\\\"\\n    s = v.replace(\\\",\\\", \\\"\\\").replace(\\\"$\\\", \\\"\\\").strip()\\n    if re.fullmatch(r\\\"-?\\\\d+\\\", s):\\n        cents = int(s)\\n        return (cents, None) if cents >= 1 else (None, \\\"invalid_amount\\\")\\n    try:\\n        cents = round(float(s) * 100)\\n    except ValueError:\\n        return None, \\\"invalid_amount\\\"\\n    return (cents, None) if cents >= 1 else (None, \\\"invalid_amount\\\")\\n\\n\\ndef normalize_row(dataset: str, raw: dict) -> tuple[dict | None, list[str]]:\\n    \\\"\\\"\\\"Normalize one raw row. Returns (row, reasons); row may be partial.\\\"\\\"\\\"\\n    row: dict = {}\\n    reasons: list[str] = []\\n    for col in COLUMNS[dataset]:\\n        src = \\\"amount\\\" if col == \\\"amount_cents\\\" else col\\n        v = clean_cell(raw.get(src))\\n        if col in UPPER_COLS:\\n            v = v.upper() if v is not None else None\\n        elif col in LOWER_COLS:\\n            v = v.lower() if v is not None else None\\n        row[col] = v\\n    for col in DATE_COLS:\\n        parsed, err = normalize_date(row.get(col))\\n        row[col] = parsed\\n        if err:\\n            reasons.append(err)\\n    if \\\"amount_cents\\\" in row:\\n        cents, err = normalize_amount(raw.get(\\\"amount\\\"))\\n        row[\\\"amount_cents\\\"] = cents\\n        if err:\\n            reasons.append(err)\\n    return row, reasons\\n\\n\\ndef validate_row(dataset: str, row: dict, rules: dict, seen_pks: set) -> list[str]:\\n    reasons: list[str] = []\\n    rule = rules[dataset]\\n    pk = PK[dataset]\\n    pkv = row.get(pk)\\n    if pkv is None or pkv == \\\"\\\":\\n        reasons.append(\\\"invalid_primary_key\\\")\\n    elif not re.fullmatch(rule[\\\"columns\\\"][pk][\\\"regex\\\"], pkv):\\n        reasons.append(\\\"invalid_primary_key\\\")\\n    elif pkv in seen_pks:\\n        reasons.append(\\\"duplicate_primary_key\\\")\\n    colrules = rule[\\\"columns\\\"]\\n    for col, cr in colrules.items():\\n        val = row.get(col)\\n        if cr.get(\\\"not_null\\\") and (val is None or val == \\\"\\\"):\\n            reasons.append(f\\\"missing_{col}\\\")\\n            continue\\n        if val in (None, \\\"\\\"):\\n            continue\\n        if col == \\\"email\\\" and not EMAIL_RE.match(val):\\n            reasons.append(\\\"invalid_email\\\")\\n        if \\\"in_set\\\" in cr and val not in cr[\\\"in_set\\\"]:\\n            if col in (\\\"status\\\", \\\"reason\\\", \\\"method\\\"):\\n                reasons.append(\\\"invalid_status\\\" if col == \\\"status\\\" else f\\\"invalid_{col}\\\")\\n            elif col == \\\"currency\\\":\\n                reasons.append(\\\"invalid_currency\\\")\\n            elif col == \\\"country\\\":\\n                reasons.append(\\\"invalid_country\\\")\\n            elif col == \\\"tier\\\":\\n                reasons.append(\\\"invalid_tier\\\")\\n            else:\\n                reasons.append(f\\\"invalid_{col}\\\")\\n        if \\\"min\\\" in cr an