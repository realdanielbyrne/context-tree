{"path":"engine.py","content":"\"\"\"Game loop: runs the per-tick order from spec/02 and returns final state.\"\"\"\n\nfrom units import BIRD_X, PIPE_W, GLIDE_VY\nfrom physics import step_bird\nfrom world import spawn, scroll, cull\nfrom collide import pipe_hit\n\n\ndef _score(pipes, y, vy, score):\n    \"\"\"Step 5: score pipes whose right edge is at or behind the bird's left.\"\"\"\n    for p in pipes:\n        if not p[\"passed\"] and p[\"x\"] + PIPE_W <= BIRD_X:\n            p[\"passed\"] = True\n            score += 1\n            if abs(vy) <= GLIDE_VY:\n                score += 1\n    return score\n\n\ndef run(seed, ticks, flaps, powerups=False):\n    \"\"\"Simulate `ticks` ticks. Returns the final state dict.\"\"\"\n    y, vy, alive = 560, 0, True\n    score, s, pipes = 0, seed, []\n    shields = 1 if powerups else 0\n    passed_count = 0\n    ticks_run = 0\n    for t in range(ticks):\n        if not alive:\n            break\n        ticks_run += 1\n        flap = flaps[t % len(flaps)] == \"1\"\n        s, pipe = spawn(t, s)\n        if pipe is not None:\n            pipes.append(pipe)\n        y, vy, alive = step_bird(y, vy, flap)\n        scroll(pipes)\n        if alive:\n            for p in pipes:\n                if pipe_hit(y, p):\n                    if powerups and shields > 0:\n                        shields -= 1\n                        p[\"passed\"] = True\n                    else:\n                        alive = False\n                    break\n        if alive:\n            score = _score(pipes, y, vy, score)\n            passed_count += sum(1 for p in pipes if p[\"passed\"])\n            if powerups and passed_count % 5 == 0:\n                shields = min(shields + 1, 3)\n        pipes = cull(pipes)\n    state = {\"y\": y, \"vy\": vy, \"score\": score, \"alive\": alive,\n             \"ticks_run\": ticks_run}\n    if powerups:\n        state[\"shields\"] = shields\n    return state\n"}