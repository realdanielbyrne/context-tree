{"path":"flapsim.py","content":"\"\"\"Command line for flapsim: hand-parsed argv, exact output format.\"\"\"\n\nimport sys\nfrom engine import run\n\n\ndef _parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps/--powerups by hand. Returns dict or None.\"\"\"\n    opts = {\"seed\": 0, \"ticks\": 0, \"flaps\": \"0\", \"powerups\": False}\n    i = 1\n    while i < len(argv):\n        a = argv[i]\n        if a == \"--selfcheck\":\n            return {\"selfcheck\": True}\n        if a in (\"--seed\", \"--ticks\") and i + 1 < len(argv):\n            opts[a[2:]] = int(argv[i + 1])\n            i += 2\n        elif a == \"--flaps\" and i + 1 < len(argv):\n            opts[\"flaps\"] = argv[i + 1] or \"0\"\n            i += 2\n        elif a == \"--powerups\":\n            opts[\"powerups\"] = True\n            i += 1\n        else:\n            return None\n    return opts\n\n\ndef _digest(st, n, powerups):\n    line = (\"DIGEST seed=%d ticks=%d score=%02d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (st[\"seed\"], n, st[\"score\"], int(st[\"alive\"]),\n                              st[\"y\"], st[\"vy\"], st[\"ticks_run\"]))\n    if powerups:\n        line += \" shields=%d\" % st[\"shields\"]\n    return line\n\n\ndef _normal(opts):\n    st = run(opts[\"seed\"], opts[\"ticks\"], opts[\"flaps\"], opts[\"powerups\"])\n    st[\"seed\"] = opts[\"seed\"]\n    n = opts[\"ticks\"]\n    every = max(1, n // 20)\n    for t in range(n):\n        if not st[\"alive\"]:\n            break\n        run_t = run(opts[\"seed\"], t + 1, opts[\"flaps\"], opts[\"powerups\"])\n        if (t + 1) % every == 0:\n            print(\"TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d\"\n                  % (t, run_t[\"y\"], run_t[\"vy\"], run_t[\"score\"],\n                     int(run_t[\"alive\"])))\n    print(_digest(st, n, opts[\"powerups\"]))\n\n\ndef _selfcheck():\n    cases = [(7, 200, \"0010\", 8, 1), (7, 120, \"01\", 0, 0),\n             (3, 200, \"0001\", 8, 1), (11, 60, \"1\", 0, 0),\n             (2, 90, \"0\", 0, 0), (5, 200, \"0010\", 8, 1)]\n    for i, (seed, ticks, flaps, escore, ealive) in enumerate(cases, 1):\n        st = run(seed, ticks, flaps)\n        ok = st[\"score\"] == escore and int(st[\"alive\"]) == ealive\n        print(\"EX%d seed=%d ticks=%d flaps=%s expect score=%02d alive=%d \"\n              \"got score=%02d alive=%d %s\"\n              % (i, seed, ticks, flaps, escore, ealive, st[\"score\"],\n                 int(st[\"alive\"]), \"OK\" if ok else \"FAIL\"))\n\n\ndef main(argv):\n    opts = _parse(argv)\n    if opts is None:\n        print(\"usage: flapsim.py --seed S --ticks N --flaps BITS [--powerups]\")\n        return 1\n    if opts.get(\"selfcheck\"):\n        _selfcheck()\n    else:\n        _normal(opts)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n"}