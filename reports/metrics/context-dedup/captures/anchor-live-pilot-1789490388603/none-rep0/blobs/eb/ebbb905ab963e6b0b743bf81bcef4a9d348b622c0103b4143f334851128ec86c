{"path":"flapsim.py","old_str":"def parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps by hand. Returns (seed, ticks, flaps).\"\"\"\n    seed, ticks, flaps = 0, 0, \"0\"\n    i = 0\n    while i < len(argv):\n        if argv[i] == \"--seed\":\n            seed = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--ticks\":\n            ticks = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--flaps\":\n            flaps = argv[i + 1]; i += 2\n        else:\n            raise SystemExit(\"unknown flag: \" + argv[i])\n    return seed, ticks, flaps","new_str":"def parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps/--powerups by hand.\"\"\"\n    seed, ticks, flaps, powerups = 0, 0, \"0\", False\n    i = 0\n    while i < len(argv):\n        if argv[i] == \"--seed\":\n            seed = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--ticks\":\n            ticks = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--flaps\":\n            flaps = argv[i + 1]; i += 2\n        elif argv[i] == \"--powerups\":\n            powerups = True; i += 1\n        else:\n            raise SystemExit(\"unknown flag: \" + argv[i])\n    return seed, ticks, flaps, powerups"}