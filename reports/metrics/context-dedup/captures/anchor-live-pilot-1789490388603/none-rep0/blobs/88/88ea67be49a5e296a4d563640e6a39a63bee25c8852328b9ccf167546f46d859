{"path":"flapsim.py","content":"\"\"\"Command line for flapsim: hand-rolled argv parsing and output.\"\"\"\n\nimport sys\nfrom engine import run\n\n\ndef parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps by hand. Returns (seed, ticks, flaps).\"\"\"\n    seed, ticks, flaps = 0, 0, \"0\"\n    i = 0\n    while i < len(argv):\n        if argv[i] == \"--seed\":\n            seed = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--ticks\":\n            ticks = int(argv[i + 1]); i += 2\n        elif argv[i] == \"--flaps\":\n            flaps = argv[i + 1]; i += 2\n        else:\n            raise SystemExit(\"unknown flag: \" + argv[i])\n    return seed, ticks, flaps\n\n\ndef trace(t, y, vy, score, alive):\n    return (\"TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d\"\n            % (t, y, vy, score, 1 if alive else 0))\n\n\ndef digest(seed, ticks, st):\n    return (\"DIGEST seed=%d ticks=%d score=%02d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"],\n                              1 if st[\"alive\"] else 0, st[\"y\"], st[\"vy\"],\n                              st[\"ticks_run\"]))\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps = parse(argv[1:])\n    every = max(1, ticks // 20)\n    y, vy, score, alive = 560, 0, 0, True\n    for t in range(ticks):\n        if not alive:\n            break\n        st = run(seed, t + 1, flaps)\n        if (t + 1) % every == 0 or not st[\"alive\"]:\n            print(trace(t, st[\"y\"], st[\"vy\"], st[\"score\"], st[\"alive\"]))\n    final = run(seed, ticks, flaps)\n    print(digest(seed, ticks, final))\n\n\ndef selfcheck():\n    cases = [(7, 200, \"0010\", 8, 1), (7, 120, \"01\", 0, 0),\n             (3, 200, \"0001\", 8, 1), (11, 60, \"1\", 0, 0),\n             (2, 90, \"0\", 0, 0), (5, 200, \"0010\", 8, 1)]\n    for i, (seed, ticks, flaps, escore, ealive) in enumerate(cases, 1):\n        st = run(seed, ticks, flaps)\n        ok = st[\"score\"] == escore and (1 if st[\"alive\"] else 0) == ealive\n        print(\"EX%d seed=%d ticks=%d flaps=%s expect score=%02d alive=%d \"\n              \"got score=%02d alive=%d %s\"\n              % (i, seed, ticks, flaps, escore, ealive, st[\"score\"],\n                 1 if st[\"alive\"] else 0, \"OK\" if ok else \"FAIL\"))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv)\n"}