{"path":"engine.py","content":"\"\"\"The deterministic run loop, following the normative per-tick order.\"\"\"\n\nfrom units import BIRD_X, PIPE_W, GLIDE_VY, SPAWN_EVERY\nfrom physics import step_bird\nfrom world import spawn, scroll, cull\nfrom collide import pipe_hit\n\n\ndef _tick(t, y, vy, score, alive, pipes, s, flap):\n    \"\"\"Execute one tick (steps 1-6). Returns the updated state tuple.\"\"\"\n    if t % SPAWN_EVERY == 0:\n        s, pipe = spawn(t, s)\n        if pipe is not None:\n            pipes.append(pipe)\n    y, vy, alive = step_bird(y, vy, flap)\n    scroll(pipes)\n    for p in pipes:\n        if alive and pipe_hit(y, p):\n            alive = False\n    if alive:\n        for p in pipes:\n            if not p[\"passed\"] and p[\"x\"] + PIPE_W <= BIRD_X:\n                p[\"passed\"] = True\n                score += 1\n                if abs(vy) <= GLIDE_VY:\n                    score += 1\n    pipes = cull(pipes)\n    return y, vy, score, alive, pipes, s\n\n\ndef run(seed, ticks, flaps=\"0\", powerups=False):\n    \"\"\"Run the simulation. Returns a state dict (see spec/00).\"\"\"\n    y, vy, score, alive = 560, 0, 0, True\n    pipes, s, ticks_run = [], seed, 0\n    for t in range(ticks):\n        if not alive:\n            break\n        flap = flaps[t % len(flaps)] == \"1\"\n        y, vy, score, alive, pipes, s = _tick(\n            t, y, vy, score, alive, pipes, s, flap)\n        ticks_run += 1\n    state = {\"y\": y, \"vy\": vy, \"score\": score,\n             \"alive\": alive, \"ticks_run\": ticks_run}\n    return state\n"}