{"path":"flapsim.py","old_str":"def digest(seed, ticks, st):\n    return (\"DIGEST seed=%d ticks=%d score=%02d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"],\n                              1 if st[\"alive\"] else 0, st[\"y\"], st[\"vy\"],\n                              st[\"ticks_run\"]))\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps = parse(argv[1:])\n    every = max(1, ticks // 20)\n    for t in range(ticks):\n        st = run(seed, t + 1, flaps)\n        if (t + 1) % every == 0:\n            print(trace(t, st[\"y\"], st[\"vy\"], st[\"score\"], st[\"alive\"]))\n        if not st[\"alive\"]:\n            break\n    final = run(seed, ticks, flaps)\n    print(digest(seed, ticks, final))","new_str":"def digest(seed, ticks, st):\n    line = (\"DIGEST seed=%d ticks=%d score=%02d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"],\n                              1 if st[\"alive\"] else 0, st[\"y\"], st[\"vy\"],\n                              st[\"ticks_run\"]))\n    if \"shields\" in st:\n        line += \" shields=%d\" % st[\"shields\"]\n    return line\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps, powerups = parse(argv[1:])\n    every = max(1, ticks // 20)\n    for t in range(ticks):\n        st = run(seed, t + 1, flaps, powerups)\n        if (t + 1) % every == 0:\n            print(trace(t, st[\"y\"], st[\"vy\"], st[\"score\"], st[\"alive\"]))\n        if not st[\"alive\"]:\n            break\n    final = run(seed, ticks, flaps, powerups)\n    print(digest(seed, ticks, final))"}