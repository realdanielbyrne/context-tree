"""Command line for flapsim: hand-rolled argv parsing and output."""

import sys
from engine import run


def parse(argv):
    """Parse --seed/--ticks/--flaps by hand. Returns (seed, ticks, flaps)."""
    seed, ticks, flaps = 0, 0, "0"
    i = 0
    while i < len(argv):
        if argv[i] == "--seed":
            seed = int(argv[i + 1]); i += 2
        elif argv[i] == "--ticks":
            ticks = int(argv[i + 1]); i += 2
        elif argv[i] == "--flaps":
            flaps = argv[i + 1]; i += 2
        else:
            raise SystemExit("unknown flag: " + argv[i])
    return seed, ticks, flaps


def trace(t, y, vy, score, alive):
    return ("TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d"
            % (t, y, vy, score, 1 if alive else 0))


def digest(seed, ticks, st):
    return ("DIGEST seed=%d ticks=%d score=%02d alive=%d y=%04d vy=%+05d "
            "ticks_run=%d" % (seed, ticks, st["score"],
                              1 if st["alive"] else 0, st["y"], st["vy"],
                              st["ticks_run"]))


def main(argv):
    if len(argv) == 2 and argv[1] == "--selfcheck":
        return selfcheck()
    seed, ticks, flaps = parse(argv[1:])
    every = max(1, ticks // 20)
    for t in range(ticks):
        st = run(seed, t + 1, flaps)
        if (t + 1) % every == 0:
            print(trace(t, st["y"], st["vy"], st["score"], st["alive"]))
        if not st["alive"]:
            break
    final = run(seed, ticks, flaps)
    print(digest(seed, ticks, final))


