import units, physics, world, collide

assert collide.rect_overlap(300, 380, 180, 300) is False
assert collide.rect_overlap(300, 380, 300, 420) is True
assert collide.pipe_hit(100 + units.GAP_H - units.BIRD_H, {"x": 250, "gap_top": 100, "passed": False}) is False
assert collide.pipe_hit(99, {"x": 250, "gap_top": 100, "passed": False}) is True
assert collide.pipe_hit(100 + units.GAP_H - units.BIRD_H + 1, {"x": 250, "gap_top": 100, "passed": False}) is True

s = world.lcg(7)
assert s == (1103515245 * 7 + 12345) % 2147483648
p, s2 = world.spawn(45, 7)
assert p["x"] == units.SPAWN_X and p["gap_top"] == 40 + (s2 >> 8) % 80
assert world.spawn(46, 7) == (None, 7)

y, vy, a = physics.step_bird(560, 0, True); assert (y, vy, a) == (533, -27, True)
y, vy, a = physics.step_bird(-10, 0, False); assert (y, vy, a) == (0, 0, True)
y, vy, a = physics.step_bird(1150, 0, False); assert (y, vy, a) == (1120, 18, False)
y, vy, a = physics.step_bird(0, 260, False); assert vy == 260

ps = [{"x": -120}, {"x": -119}]
assert world.cull(ps) == [{"x": -119}]
print("all checks passed")
