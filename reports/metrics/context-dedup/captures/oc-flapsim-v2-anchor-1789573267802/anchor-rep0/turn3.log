import sys, itertools
sys.path.insert(0, "/tmp/oc-anchor-k2mq6z")
from units import *
from physics import step_bird
from world import spawn, scroll, cull
from collide import pipe_hit

def full(seed, ticks, flaps):
    y, vy, score, s, alive = 560, 0, 0, seed, True
    pipes, trun, scored = [], 0, []
    for t in range(ticks):
        trun = t + 1
        p, s = spawn(t, s)
        if p: pipes.append(p)
        y, vy, alive = step_bird(y, vy, flaps[t % len(flaps)] == "1")
        scroll(pipes)
        hit = False
        if alive:
            for q in pipes:
                if pipe_hit(y, q):
                    alive = False; hit = True; break
        if alive:
            for q in pipes:
                if not q["passed"] and q["x"] + PIPE_W <= BIRD_X:
                    q["passed"] = True
                    score += 1
                    if abs(vy) <= GLIDE_VY: score += 1
                    scored.append((t, vy))
            pipes = cull(pipes)
        else:
            crossed = any(q["x"] == 160 for q in pipes)
            return trun, score, alive, hit, crossed, scored
    return ticks, score, True, False, False, scored

def bird_traj(flaps, maxt=400):
    y, vy, out = 560, 0, []
    for t in range(maxt):
        y, vy, alive = step_bird(y, vy, flaps[t % len(flaps)] == "1")
        out.append(y)
        if not alive:
            break
    return out

cands = []
for L in range(1, 15):
    for bits in itertools.product("01", repeat=L):
        fl = "".join(bits)
        tr = bird_traj(fl)
        d = len(tr) - 1
        if d % 45 == 0 and d >= 45:
            winmax = max(tr[d-5:d])
            if winmax + BIRD_H <= FIELD_H:   # clears every possible gap
                cands.append((fl, d, winmax))
print(len(cands), "feasible candidates")
found = []
for fl, d, wm in sorted(cands, key=lambda c: c[1]):
    for seed in range(0, 600):
        trun, score, alive, hit, crossed, scored = full(seed, d + 5, fl)
        if (not alive) and not hit and crossed and (trun - 1) == d:
            found.append((seed, d + 5, fl, d, score, scored))
            break
    if len(found) >= 2:
        break
for f in found:
    print("FOUND seed=%d ticks=%d flaps=%s die_t=%d score=%d passes=%s" % f)
EOF
