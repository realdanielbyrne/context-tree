import sys, itertools
sys.path.insert(0, "/tmp/oc-anchor-k2mq6z")
from units import *
from physics import step_bird
from world import spawn, scroll, cull
from collide import pipe_hit

def traj(flaps, maxt=600):
    """bird-only trajectory: list of (y, vy) after each tick t"""
    y, vy, out = 560, 0, []
    for t in range(maxt):
        y, vy, alive = step_bird(y, vy, flaps[t % len(flaps)] == "1")
        out.append((y, vy))
        if not alive:
            break
    return out

def full(seed, ticks, flaps):
    y, vy, score, s, alive = 560, 0, 0, seed, True
    pipes, trun, scored = [], 0, []
    for t in range(ticks):
        trun = t + 1
        p, s = spawn(t, s)
        if p: pipes.append(p)
        y, vy, alive = step_bird(y, vy, flaps[t % len(flaps)] == "1")
        scroll(pipes)
        hit = False
        if alive:
            for q in pipes:
                if pipe_hit(y, q):
                    alive = False; hit = True; break
        if alive:
            for q in pipes:
                if not q["passed"] and q["x"] + PIPE_W <= BIRD_X:
                    q["passed"] = True
                    score += 1
                    if abs(vy) <= GLIDE_VY: score += 1
                    scored.append((t, vy))
            pipes = cull(pipes)
        else:
            crossed = any(q["x"] == SPAWN_X - SCROLL * 46 for q in pipes)
            return y, vy, score, alive, trun, scored, hit, crossed
    return y, vy, score, alive, trun, scored, False, False

print("== patterns with |vy|>40 at a pass tick (t=45k+45), bird still airborne ==")
cands = []
for L in range(1, 9):
    for bits in itertools.product("01", repeat=L):
        fl = "".join(bits)
        tr = traj(fl)
        for t in (45, 90, 135, 180, 225, 270):
            if t < len(tr) and abs(tr[t][1]) > GLIDE_VY:
                cands.append((fl, t, tr[t]))
                break
print(len(cands), "candidates; first few:", cands[:8])

print("== patterns that floor-die exactly on a crossing tick ==")
die_cands = []
for L in range(1, 9):
    for bits in itertools.product("01", repeat=L):
        fl = "".join(bits)
        tr = traj(fl)
        d = len(tr) - 1  # death tick (floor; pipe hits ignored here)
        if d in (45, 90, 135, 180, 225, 270):
            die_cands.append((fl, d))
print(len(die_cands), "candidates; first few:", die_cands[:8])

print("== confirm non-glide with seeds ==")
n = 0
for fl, t, (yy, vyv) in cands:
    for seed in range(0, 100):
        y, vy, score, alive, trun, scored, hit, crossed = full(seed, t + 5, fl)
        if alive and not hit and any(abs(v) > GLIDE_VY for _, v in scored):
            print(f"seed={seed} ticks={t+5} flaps={fl} score={score} passes={scored}")
            n += 1
            break
    if n >= 3: break

print("== confirm floor-death-on-crossing with seeds ==")
n = 0
for fl, d in die_cands:
    for seed in range(0, 200):
        y, vy, score, alive, trun, scored, hit, crossed = full(seed, d + 5, fl)
        if (not alive) and not hit and crossed and (trun - 1) == d:
            print(f"seed={seed} ticks={d+5} flaps={fl} die_t={d} score={score} passes={scored}")
            n += 1
            break
    if n >= 3: break
EOF
