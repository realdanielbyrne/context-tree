         st = engine.run(7, 200, "0010")
         self.assertEqual(set(st), {"y", "vy", "score", "alive", "ticks_run"})
 
 
+class PowerupsTests(unittest.TestCase):
+    def test_shields_key_only_with_powerups(self):
+        self.assertNotIn("shields", engine.run(7, 200, "0010"))
+        self.assertIn("shields", engine.run(7, 200, "0010", True))
+
+    def test_starts_with_one_shield(self):
+        st = engine.run(7, 200, "0010", True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["shields"], 1)
+
+    def test_shield_absorbs_pipe_hit(self):
+        plain = engine.run(7, 120, "01")
+        shielded = engine.run(7, 120, "01", True)
+        self.assertFalse(plain["alive"])
+        self.assertEqual(plain["ticks_run"], 41)
+        # the shield eats the first hit tick; with none left the bird dies next tick
+        self.assertFalse(shielded["alive"])
+        self.assertEqual(shielded["ticks_run"], 42)
+        self.assertEqual(shielded["shields"], 0)
+
+    def test_floor_kill_not_prevented(self):
+        st = engine.run(7, 50, "0100101000000011", True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 46)
+        self.assertEqual(st["shields"], 1)
+
+    def test_grant_every_fifth_pipe(self):
+        st = engine.run(7, 300, "0010", True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["shields"], 2)
+
+    def test_shield_cap_at_three(self):
+        st = engine.run(7, 700, "0010", True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["shields"], 3)
+
+    def test_digest_shields_field(self):
+        import io, contextlib
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            flapsim.main(["--seed", "7", "--ticks", "200", "--flaps", "0010", "--powerups"])
+        lines = buf.getvalue().splitlines()
+        self.assertTrue(lines[-1].startswith("DIGEST "))
+        self.assertTrue(lines[-1].endswith(" ticks_run=200 shields=1"))
+
+
 if __name__ == "__main__":
     unittest.main()

