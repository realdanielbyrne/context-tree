{"path":"collide.py","content":"\"\"\"Axis-aligned collision with half-open intervals. Edges do not collide.\"\"\"\n\nfrom units import BIRD_X, BIRD_W, BIRD_H, PIPE_W, GAP_H\n\n\ndef rect_overlap(a0, a1, b0, b1):\n    \"\"\"True if the half-open intervals [a0,a1) and [b0,b1) overlap.\"\"\"\n    return a0 < b1 and b0 < a1\n\n\ndef pipe_hit(y, pipe):\n    \"\"\"True if the bird at height y hits the given pipe.\n\n    The bird occupies [BIRD_X, BIRD_X+BIRD_W) x [y, y+BIRD_H). A hit needs\n    horizontal overlap AND being outside the open gap\n    [gap_top, gap_top+GAP_H).\n    \"\"\"\n    x = pipe[\"x\"]\n    gap_top = pipe[\"gap_top\"]\n    horizontal = rect_overlap(BIRD_X, BIRD_X + BIRD_W, x, x + PIPE_W)\n    outside = y < gap_top or y + BIRD_H > gap_top + GAP_H\n    return horizontal and outside\n"}