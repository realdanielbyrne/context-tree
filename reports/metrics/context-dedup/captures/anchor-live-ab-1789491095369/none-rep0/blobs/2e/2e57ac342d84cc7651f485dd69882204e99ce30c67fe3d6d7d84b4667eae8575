{"path":"test_flapsim.py","content":"\"\"\"Stdlib unittest suite for flapsim: physics, LCG, AABB, scoring, order.\"\"\"\n\nimport unittest\n\nfrom units import (FIELD_H, BIRD_H, G, FLAP_V, VY_MAX, SCROLL, PIPE_W,\n                   GAP_H, SPAWN_X, BIRD_X, GLIDE_VY)\nfrom physics import step_bird\nfrom world import lcg, spawn, scroll, cull\nfrom collide import rect_overlap, pipe_hit\nfrom engine import run\n\n\nclass TestPhysics(unittest.TestCase):\n    def test_flap_sets_vy(self):\n        y, vy, alive = step_bird(560, 200, True)\n        self.assertEqual((y, vy, alive), (533, FLAP_V, True))\n\n    def test_gravity_clamped_at_vy_max(self):\n        y, vy, alive = step_bird(100, VY_MAX + 50, False)\n        self.assertEqual(vy, VY_MAX)\n        self.assertEqual(y, 100 + VY_MAX)\n\n    def test_gravity_not_clamped_below_max(self):\n        _, vy, _ = step_bird(100, 10, False)\n        self.assertEqual(vy, 10 + G)\n\n    def test_ceiling_is_soft(self):\n        y, vy, alive = step_bird(-5, -27, True)\n        self.assertEqual((y, vy, alive), (0, 0, True))\n\n    def test_floor_kills_and_clamps_y(self):\n        y, vy, alive = step_bird(FIELD_H - BIRD_H + 10, 18, False)\n        self.assertFalse(alive)\n        self.assertEqual(y, FIELD_H - BIRD_H)\n        self.assertNotEqual(vy, 0)  # floor does not zero vy\n\n\nclass TestLcg(unittest.TestCase):\n    def test_lcg_formula(self):\n        self.assertEqual(lcg(7), (1103515245 * 7 + 12345) % 2147483648)\n\n    def test_spawn_advances_once_and_gap_range(self):\n        s, pipe = spawn(0, 7)\n        self.assertEqual(s, lcg(7))\n        self.assertTrue(40 <= pipe[\"gap_top\"] < 120)\n        self.assertEqual(pipe[\"x\"], SPAWN_X)\n\n    def test_no_spawn_off_tick(self):\n        s, pipe = spawn(1, 7)\n        self.assertIsNone(pipe)\n        self.assertEqual(s, 7)\n\n\nclass TestAabb(unittest.TestCase):\n    def test_touching_edges_do_not_overlap(self):\n        self.assertFalse(rect_overlap(0, 10, 10, 20))\n        self.assertFalse(rect_overlap(10, 20, 0, 10))\n\n    def test_interior_overlaps(self):\n        self.assertTrue(rect_overlap(0, 10, 5, 15))\n\n    def test_pipe_right_edge_at_bird_left_no_hit(self):\n        pipe = {\"x\": BIRD_X - PIPE_W, \"gap_top\": 0}\n        self.assertFalse(pipe_hit(560, pipe))\n\n    def test_bottom_exactly_gap_floor_survives(self):\n        gap_top = 100\n        y = gap_top + GAP_H - BIRD_H\n        pipe = {\"x\": BIRD_X, \"gap_top\": gap_top}\n        self.assertFalse(pipe_hit(y, pipe))\n\n    def test_one_centibelow_gap_floor_hits(self):\n        gap_top = 100\n        pipe = {\"x\": BIRD_X, \"gap_top\": gap_top}\n        self.assertTrue(pipe_hit(gap_top + GAP_H - BIRD_H + 1, pipe))\n\n\nclass TestScoring(unittest.TestCase):\n    def test_clean_glide_bonus(self):\n        pipes = [{\"x\": BIRD_X - PIPE_W, \"gap_top\": 40, \"passed\": False}]\n        from engine import _score\n        self.assertEqual(_score(pipes, GLIDE_VY, 0), 2)\n\n    def test_hard_dive_no_bonus(self):\n        pipes = [{\"x\": BIRD_X - PIPE_W, \"gap_top\": 40, \"passed\": False}]\n        from engine import _score\n        self.assertEqual(_score(pipes, GLIDE_VY + 1, 0), 1)\n\n    def test_pipe_scored_only_once(self):\n        pipes = [{\"x\": BIRD_X - PIPE_W, \"gap_top\": 40, \"passed\": False}]\n        from engine import _score\n        s = _score(pipes, 0, 0)\n        self.assertEqual(_score(pipes, 0, s), s)\n\n\nclass TestTickOrder(unittest.TestCase):\n    def test_ticks_run_includes_fatal_tick(self):\n        st = run(2, 90, \"0\")\n        self.assertFalse(st[\"alive\"])\n        self.assertLessEqual(st[\"ticks_run\"], 90)\n        self.assertEqual(run(2, st[\"ticks_run\"] + 5, \"0\")[\"ticks_run\"],\n                         st[\"ticks_run\"])\n\n    def test_cull_after_score(self):\n        # A pipe culled this tick must still have been scored first.\n        st = run(7, 200, \"0010\")\n        self.assertEqual(st[\"score\"], 8)\n\n    def test_scroll_before_collide(self):\n        # With flaps=0 the bird falls; it dies by floor or pipe, not at t=0.\n        st = run(7, 120, \"01\")\n        self.assertFalse(st[\"alive\"])\n        self.assertEqual(st[\"score\"], 0)\n\n    def test_spawn_before_physics(self):\n        # A pipe spawned at t=0 sits at SPAWN_X and cannot hit the bird yet.\n        st = run(7, 1, \"0\")\n        self.assertTrue(st[\"alive\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}