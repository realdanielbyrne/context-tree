{"path":"world.py","content":"\"\"\"World generation: the LCG and pipe spawning, scrolling, culling.\"\"\"\n\nfrom units import SPAWN_X, SCROLL, PIPE_W\n\n\ndef lcg(s):\n    \"\"\"Advance the LCG once; return the new state.\"\"\"\n    return (1103515245 * s + 12345) % 2147483648\n\n\ndef spawn(t, s):\n    \"\"\"If tick t is a spawn tick, return (new_state, pipe_or_None).\"\"\"\n    if t % 45 != 0:\n        return s, None\n    s = lcg(s)\n    gap_top = 40 + (s >> 8) % 80\n    return s, {\"x\": SPAWN_X, \"gap_top\": gap_top, \"passed\": False}\n\n\ndef scroll(pipes):\n    \"\"\"Move every pipe left by SCROLL.\"\"\"\n    for p in pipes:\n        p[\"x\"] -= SCROLL\n\n\ndef cull(pipes):\n    \"\"\"Drop every pipe whose right edge is at or behind x=0.\"\"\"\n    return [p for p in pipes if p[\"x\"] + PIPE_W > 0]\n"}