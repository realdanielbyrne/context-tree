{"path":"engine.py","content":"\"\"\"The deterministic run loop. Per-tick order is normative (spec/02).\"\"\"\n\nfrom units import BIRD_X, PIPE_W, GLIDE_VY\nfrom physics import step_bird\nfrom world import spawn, scroll, cull\nfrom collide import pipe_hit\n\n\ndef _score(pipes, vy, score):\n    \"\"\"Step 5: award points for pipes whose right edge is behind the bird.\"\"\"\n    for p in pipes:\n        if not p[\"passed\"] and p[\"x\"] + PIPE_W <= BIRD_X:\n            p[\"passed\"] = True\n            score += 1\n            if abs(vy) <= GLIDE_VY:\n                score += 1\n    return score\n\n\ndef run(seed, ticks, flaps=\"0\", powerups=False):\n    \"\"\"Simulate `ticks` ticks. Returns the final state dict.\"\"\"\n    y, vy, alive = 560, 0, True\n    score, pipes, s = 0, [], seed\n    ticks_run = 0\n    for t in range(ticks):\n        if not alive:\n            break\n        ticks_run = t + 1\n        s, pipe = spawn(t, s)          # 1. SPAWN\n        if pipe is not None:\n            pipes.append(pipe)\n        y, vy, alive = step_bird(y, vy, flaps[t % len(flaps)] == \"1\")  # 2\n        scroll(pipes)                  # 3. SCROLL\n        for p in pipes:                # 4. COLLIDE\n            if pipe_hit(y, p):\n                alive = False\n                break\n        if alive:                      # 5. SCORE (dead ticks score nothing)\n            score = _score(pipes, vy, score)\n        pipes = cull(pipes)            # 6. CULL\n    state = {\"y\": y, \"vy\": vy, \"score\": score,\n             \"alive\": alive, \"ticks_run\": ticks_run}\n    return state\n"}