assert collide.pipe_hit(560, {"x": units.BIRD_X - units.PIPE_W, "gap_top": 40}) is False        # pipe right edge exactly BIRD_X
assert collide.pipe_hit(30, {"x": units.BIRD_X, "gap_top": 40}) is True                          # above gap
print("all checks passed")
