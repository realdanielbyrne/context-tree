import units, physics, world, collide

# physics: flap sets vy; gravity clamps at VY_MAX; ceiling soft; floor kills
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 250, False) == (820, 260, True)
assert physics.step_bird(-10, 5, False) == (0, 0, True)
assert physics.step_bird(units.FIELD_H - 70, 260, False) == (units.FIELD_H - units.BIRD_H, 260, False)

# world: lcg + spawn only on t % 45 == 0, advances state once
s = 1
p, s1 = world.spawn(0, 1)
assert s1 == world.lcg(1) and p["gap_top"] == 40 + (s1 >> 8) % 80 and p["x"] == units.SPAWN_X and p["passed"] is False
p2, s2 = world.spawn(1, s1)
assert p2 is None and s2 == s1
pipes = [{"x": 50, "gap_top": 40, "passed": True}, {"x": -119, "gap_top": 40, "passed": False}]
world.scroll(pipes)
assert pipes[0]["x"] == 10 and pipes[1]["x"] == -159
assert world.cull(pipes) == [pipes[0]]

# collide: half-open boundaries per spec/04
assert collide.rect_overlap(0, 10, 10, 20) is False
assert collide.pipe_hit(units.FIELD_H - units.BIRD_H - 960, {"x": 300, "gap_top": 40}) is False  # bottom exactly gap bottom -> inside
