[0m$ [0mpython3 - <<'EOF'
import units, physics, world, collide

assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 250, False) == (820, 260, True)
assert physics.step_bird(10, -27, True) == (0, 0, True)
assert physics.step_bird(units.FIELD_H - 70, 260, False) == (units.FIELD_H - units.BIRD_H, 260, False)

s1 = world.lcg(1)
p, s2 = world.spawn(0, 1)
assert s2 == s1 and p["gap_top"] == 40 + (s1 >> 8) % 80 and p["x"] == units.SPAWN_X and p["passed"] is False
assert world.spawn(1, s2) == (None, s2)
pipes = [{"x": 50, "gap_top": 40, "passed": True}, {"x": -119, "gap_top": 40, "passed": False}]
world.scroll(pipes)
assert pipes[0]["x"] == 10 and pipes[1]["x"] == -159
assert world.cull(pipes) == [pipes[0]]

assert collide.rect_overlap(0, 10, 10, 20) is False
gap = {"x": units.BIRD_X, "gap_top": 40}
assert collide.pipe_hit(30, gap) is True      # above the gap -> hit
assert collide.pipe_hit(40, gap) is False     # top exactly gap_top -> inside
assert collide.pipe_hit(960, gap) is False    # bottom exactly gap_top+GAP_H (1040) -> inside
assert collide.pipe_hit(560, {"x": units.BIRD_X - units.PIPE_W, "gap_top": 40}) is False
print("all checks passed")
EOF
