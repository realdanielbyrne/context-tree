import re
doc = open("GETTING_STARTED.md").read()
replay = open("replay.txt").read()

# 1. first fenced block == replay.txt
block = re.search(r"```\n(.*?)```", doc, re.S).group(1)
print("demo block vs replay.txt:", "byte-identical" if block == replay else "DIFFERS")

# 2. every quoted def/constant line exists verbatim in its module file
quotes = {
    "units.py": ["FIELD_H = 1200"],
    "physics.py": ["def step_bird(y, vy, flap):"],
    "world.py": ["def lcg(s):", "def spawn(t, s):", "def scroll(pipes):", "def cull(pipes):"],
    "collide.py": ["def rect_overlap(a0, a1, b0, b1):", "def pipe_hit(y, pipe):"],
    "engine.py": ["def run(seed, ticks, flaps, powerups=False, on_tick=None):"],
    "flapsim.py": ["def parse(argv):", "def digest(seed, ticks, st):", "def selfcheck():", "def main(argv):"],
}
ok = True
for fname, lines in quotes.items():
    src = open(fname).read()
    for line in lines:
        if line not in src:
            ok = False
            print("MISSING in %s: %r" % (fname, line))
print("quoted signatures:", "all verbatim" if ok else "MISMATCH")

# 3. the --powerups DIGEST example in the doc matches actual output
import subprocess
out = subprocess.run(["python3", "flapsim.py", "--seed", "7", "--ticks", "200",
                      "--flaps", "0010", "--powerups"], capture_output=True, text=True).stdout
last = out.strip().splitlines()[-1]
print("powerups digest in doc:", "matches" if last in doc else "MISMATCH: " + last)
EOF
