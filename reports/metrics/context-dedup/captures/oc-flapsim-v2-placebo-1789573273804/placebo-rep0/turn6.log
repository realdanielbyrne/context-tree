+class ShieldTests(unittest.TestCase):
+    def test_shields_key_only_with_powerups(self):
+        self.assertNotIn("shields", engine.run(7, 200, "0010"))
+        self.assertIn("shields", engine.run(7, 200, "0010", True))
+
+    def test_no_powerups_state_unchanged(self):
+        st = engine.run(7, 200, "0010")
+        self.assertEqual(st, {"y": 578, "vy": -9, "score": 8, "alive": True,
+                              "ticks_run": 200})
+
+    def test_shield_absorbs_collision_per_tick(self):
+        # EX2 trajectory: the bird sticks to the ceiling and pipe 0 overlaps it
+        # from t=40. Without shields it dies at t=40; with one shield the hit at
+        # t=40 is absorbed, but the overlap continues at t=41 with none left.
+        self.assertEqual(engine.run(7, 120, "01")["ticks_run"], 41)
+        st = engine.run(7, 120, "01", True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 42)
+        self.assertEqual(st["shields"], 0)
+
+    def test_shield_does_not_prevent_floor_kill(self):
+        st = engine.run(2, 90, "0", True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 8)
+        self.assertEqual(st["shields"], 1)
+
+    def test_shield_hit_pipe_never_scored(self):
+        # Flap 38 ticks to the ceiling, then fall: at t=40 the bird's top (y=108)
+        # is one centi-unit above pipe 0's gap_top (109 for seed 7), so the hit is
+        # absorbed; the bird drops into the gap and survives past the pass tick
+        # t=45, where the flagged pipe must not score. Floor kill at t=48.
+        self.assertEqual(engine.run(7, 60, "1" * 38 + "0" * 22)["ticks_run"], 41)
+        st = engine.run(7, 60, "1" * 38 + "0" * 22, True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["score"], 0)
+        self.assertEqual(st["ticks_run"], 49)
+        self.assertEqual(st["shields"], 0)
+
+    def test_refill_every_5th_pipe(self):
+        st = engine.run(7, 300, "0010", True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 12)
+        self.assertEqual(st["shields"], 2)
+
+    def test_refill_capped_at_3(self):
+        st = engine.run(7, 500, "0010", True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 20)
+        self.assertEqual(st["shields"], 3)
+
+
 if __name__ == "__main__":
     unittest.main()

