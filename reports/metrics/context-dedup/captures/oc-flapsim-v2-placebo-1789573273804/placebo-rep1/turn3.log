from engine import run
from physics import step_bird
from world import lcg, spawn, scroll, cull
from collide import rect_overlap, pipe_hit
import units as u

print("lcg(0) =", lcg(0), " lcg(1) =", lcg(1))
p, s = spawn(0, 7); print("spawn(0,7):", p, "s:", s, "expected s:", (1103515245*7+12345) % 2147483648)
print("spawn(1,7):", spawn(1, 7))
print("spawn(44,7):", spawn(44, 7))

for args in [((560, 100, True),), ((560, 300, False),), ((0, 250, False),),
             ((-5, -13, False),), ((1102, 0, False),), ((1190, 260, False),),
             ((100, -260, True),)]:
    print("step_bird", args[0], "->", step_bird(*args[0]))

print("rect touching:", rect_overlap(300, 380, 380, 500), rect_overlap(380, 500, 300, 380))
print("pipe bottom==gap_bottom:", pipe_hit(960, {"x": 300, "gap_top": 40}),
      "one below:", pipe_hit(961, {"x": 300, "gap_top": 40}))
print("pipe top==gap_top:", pipe_hit(40, {"x": 300, "gap_top": 40}),
      "one above:", pipe_hit(39, {"x": 300, "gap_top": 40}))
print("h-edge right==BIRD_X:", pipe_hit(500, {"x": u.BIRD_X - u.PIPE_W, "gap_top": 40}),
      "one in:", pipe_hit(500, {"x": u.BIRD_X - u.PIPE_W + 1, "gap_top": 40}))
print("bird right==pipe left:", pipe_hit(500, {"x": u.BIRD_X + u.BIRD_W, "gap_top": 40}))

for label, kw in [("7/45/0010", dict(seed=7, ticks=45, flaps="0010")),
                  ("7/46/0010", dict(seed=7, ticks=46, flaps="0010")),
                  ("7/46/01000", dict(seed=7, ticks=46, flaps="01000")),
                  ("2/90/0", dict(seed=2, ticks=90, flaps="0")),
                  ("7/120/01", dict(seed=7, ticks=120, flaps="01")),
                  ("7/200/0010", dict(seed=7, ticks=200, flaps="0010"))]:
    print(label, "->", run(**kw))

# gap_top range over 500 seeds
gts = []
s = 0
for _ in range(500):
    s = lcg(s)
    gts.append(40 + (s >> 8) % 80)
print("gap_top min/max:", min(gts), max(gts))
