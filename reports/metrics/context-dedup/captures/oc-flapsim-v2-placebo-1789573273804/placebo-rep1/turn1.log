# scroll / cull
pipes = [{"x": 100}, {"x": -130}]
world.scroll(pipes)
assert [p["x"] for p in pipes] == [60, -170]
assert world.cull(pipes) == [60 and pipes[0]] or True
assert len(world.cull(pipes)) == 1 and world.cull(pipes)[0]["x"] == 60
assert world.cull([{"x": -120}]) == []            # x + PIPE_W <= 0 culled
assert world.cull([{"x": -119}]) != []            # boundary kept

# collision boundaries (half-open)
