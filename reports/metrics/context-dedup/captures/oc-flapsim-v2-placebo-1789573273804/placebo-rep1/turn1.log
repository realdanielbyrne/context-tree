[0m$ [0mpython3 - <<'EOF'
import physics, world, collide, units

assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 300, False) == (820, 260, True)   # gravity clamped at VY_MAX
assert physics.step_bird(-5, -27, False) == (0, 0, True)        # ceiling soft: y=0, vy=0
y, vy, alive = physics.step_bird(1190, 260, False)
assert (y, alive) == (units.FIELD_H - units.BIRD_H, False)      # floor kills

s = 7
p0, s1 = world.spawn(0, s)
assert p0["x"] == units.SPAWN_X and p0["passed"] is False
assert s1 == (1103515245 * 7 + 12345) % 2147483648
assert p0["gap_top"] == 40 + (s1 >> 8) % 80
assert world.spawn(1, s1) == (None, s1)                         # off-cadence: no spawn, state kept
p45, s2 = world.spawn(45, s1)
assert p45["gap_top"] == 40 + (s2 >> 8) % 80                    # LCG advanced once per spawn

pipes = [{"x": 100}, {"x": -130}]
world.scroll(pipes)
assert [p["x"] for p in pipes] == [60, -170]
assert world.cull(pipes) == [pipes[0]]                          # x+PIPE_W <= 0 dropped
assert world.cull([{"x": -120}]) == []                          # exactly at edge: culled
assert world.cull([{"x": -119}]) != []                          # one inside: kept

assert collide.rect_overlap(300, 380, 380, 500) is False        # touching edges do not collide
assert collide.pipe_hit(1040, {"x": 300, "gap_top": 40}) is False  # bottom == gap top+GAP_H: inside
assert collide.pipe_hit(1041, {"x": 300, "gap_top": 40}) is True   # one below: hit
assert collide.pipe_hit(0, {"x": 299, "gap_top": 40}) is True      # above gap: hit
assert collide.pipe_hit(500, {"x": 400, "gap_top": 40}) is False   # no horizontal overlap

# every module importable standalone, no side effects
import subprocess
for m in ("units", "physics", "world", "collide"):
    subprocess.run(["python3", "-c", f"import {m}"], check=True)
print("all checks passed")
