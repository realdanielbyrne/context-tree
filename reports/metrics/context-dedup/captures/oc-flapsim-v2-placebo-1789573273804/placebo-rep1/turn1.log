assert collide.rect_overlap(300, 380, 380, 500) is False   # touching edge
assert collide.pipe_hit(1040, {"x": 300, "gap_top": 40}) is False  # bottom == gap_top+GAP_H inside
assert collide.pipe_hit(1041, {"x": 300, "gap_top": 40}) is True   # one below -> hit
assert collide.pipe_hit(0, {"x": 299, "gap_top": 40}) is True      # above gap
assert collide.pipe_hit(500, {"x": 400, "gap_top": 40}) is False   # no horizontal overlap
print("all checks passed")
