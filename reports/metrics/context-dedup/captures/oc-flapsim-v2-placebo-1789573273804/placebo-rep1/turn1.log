import physics, world, collide, units

# physics: flap sets vy (no clamp), gravity clamps at VY_MAX
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 300, False) == (820, 260, True)  # clamped
# ceiling soft: y<0 -> y=0, vy=0
assert physics.step_bird(-5, -10, False) == (0, 0, True)
# floor kills and clamps y
y, vy, alive = physics.step_bird(1190, 260, False)
assert (y, alive) == (units.FIELD_H - units.BIRD_H, False)

# lcg determinism + spawn cadence
s = 7
p0, s1 = world.spawn(0, s)
assert p0["x"] == units.SPAWN_X and p0["passed"] is False
assert s1 == (1103515245 * 7 + 12345) % 2147483648
assert p0["gap_top"] == 40 + (s1 >> 8) % 80
assert world.spawn(1, s1) == (None, s1)          # no spawn off-cadence
