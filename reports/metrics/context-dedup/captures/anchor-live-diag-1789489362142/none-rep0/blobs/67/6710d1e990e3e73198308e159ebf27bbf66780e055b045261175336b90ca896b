{"path":"cli.py","content":"\"\"\"Command-line front end.\n\nMay import parsing, rules and report only. main() returns an int exit code and\nnever calls sys.exit itself; diagnostics go to stderr via print(...,\nfile=sys.stderr), the report goes to stdout. No business logic lives here.\n\"\"\"\n\nimport argparse\nimport sys\n\nimport parsing\nimport rules\nimport report\n\n\ndef main(argv):\n    \"\"\"Run the CLI over argv (WITHOUT the program name) and return an exit code.\n\n    Exit codes: 0 success, 1 --strict with malformed lines, 2 unreadable file\n    or malformed rules. Never raises for bad input.\n    \"\"\"\n    parser = argparse.ArgumentParser(prog=\"ledger\")\n    parser.add_argument(\"command\", choices=[\"report\"])\n    parser.add_argument(\"--ledger\", required=True)\n    parser.add_argument(\"--rules\", required=True)\n    parser.add_argument(\"--strict\", action=\"store_true\")\n    args = parser.parse_args(argv)\n\n    try:\n        with open(args.ledger, \"r\") as f:\n            ledger_text = f.read()\n    except OSError:\n        print(\"cannot read %s\" % args.ledger, file=sys.stderr)\n        return 2\n    try:\n        with open(args.rules, \"r\") as f:\n            rules_text = f.read()\n    except OSError:\n        print(\"cannot read %s\" % args.rules, file=sys.stderr)\n        return 2\n\n    try:\n        rule_list = rules.load_rules(rules_text)\n    except ValueError as exc:\n        print(\"rules error: %s\" % exc, file=sys.stderr)\n        return 2\n\n    txns, errors = parsing.parse_lines(ledger_text.splitlines())\n\n    if args.strict and errors:\n        for lineno, message in errors:\n            print(\"line %d: %s\" % (lineno, message), file=sys.stderr)\n        return 1\n\n    print(report.render_report(report.summarize(txns, rule_list)))\n\n    if errors and not args.strict:\n        print(\n            \"warning: %d malformed line(s) skipped\" % len(errors),\n            file=sys.stderr,\n        )\n\n    return 0\n"}