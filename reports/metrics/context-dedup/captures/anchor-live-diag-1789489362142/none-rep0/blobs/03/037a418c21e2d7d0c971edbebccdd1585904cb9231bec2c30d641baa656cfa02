{"path":"parsing.py","content":"\"\"\"Ledger line parsing.\n\nMay import money and nothing else from the project. Raises LedgerError, never\nValueError: the ValueError from money.parse_amount is converted here.\n\"\"\"\n\nimport re\n\nimport money\n\n\nclass LedgerError(Exception):\n    \"\"\"Raised for any malformed ledger line.\n\n    The message is free text but must be a non-empty string; parse_lines\n    records str(exc) for each failing line and callers print it.\n    \"\"\"\n\n\n_DATE_SHAPE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\n\ndef _check_date(date_str):\n    if not _DATE_SHAPE.match(date_str):\n        raise LedgerError(\"bad date shape: %r\" % date_str)\n    year, month, day = (int(p) for p in date_str.split(\"-\"))\n    try:\n        import datetime\n\n        datetime.date(year, month, day)\n    except ValueError:\n        raise LedgerError(\"not a real calendar date: %r\" % date_str)\n\n\ndef parse_line(line):\n    \"\"\"Parse one ledger line into a txn dict.\n\n    Stage 2 form: DATE | DESCRIPTION | AMOUNT (exactly three fields).\n    Returns {\"date\", \"desc\", \"amount\", \"tags\"} with tags always present.\n    Raises LedgerError for any malformed input.\n    \"\"\"\n    fields = line.split(\"|\")\n    if len(fields) != 3:\n        raise LedgerError(\"expected 3 pipe-separated fields, got %d\" % len(fields))\n\n    date_str, desc, amount_str = (f.strip() for f in fields)\n\n    _check_date(date_str)\n\n    if not desc:\n        raise LedgerError(\"empty description\")\n\n    try:\n        cents = money.parse_amount(amount_str)\n    except ValueError as exc:\n        raise LedgerError(\"bad amount %r: %s\" % (amount_str, exc))\n\n    return {\"date\": date_str, \"desc\": desc, \"amount\": cents, \"tags\": []}\n\n\ndef parse_lines(lines):\n    \"\"\"Parse an iterable of lines into a 2-tuple (txns, errors).\n\n    Skips blank and \"#\" comment lines silently. Malformed lines become\n    (lineno, message) pairs with a 1-based lineno counting every element of\n    the input, including skipped ones. Never raises for bad lines.\n    \"\"\"\n    txns = []\n    errors = []\n    for lineno, line in enumerate(lines, start=1):\n        stripped = line.strip()\n        if not stripped or stripped.startswith(\"#\"):\n            continue\n        try:\n            txns.append(parse_line(line))\n        except LedgerError as exc:\n            errors.append((lineno, str(exc)))\n    return (txns, errors)\n"}