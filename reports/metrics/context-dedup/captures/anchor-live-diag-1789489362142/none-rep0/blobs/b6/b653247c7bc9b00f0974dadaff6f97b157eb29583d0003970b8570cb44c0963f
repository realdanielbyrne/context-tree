{"path":"report.py","content":"\"\"\"Aggregation and fixed-width rendering.\n\nMay import money and rules only. summarize decides what is in the table and in\nwhat order; render_report only decides how it looks and never re-sorts. All\nmoney text goes through money.format_amount.\n\"\"\"\n\nimport money\nimport rules\n\n\ndef summarize(txns, rule_list):\n    \"\"\"Group txns by category into [(category, total_cents, count)].\n\n    Sorted by total ascending (most negative first), ties broken by category\n    name ascending with plain case-sensitive str comparison. Returns a list of\n    3-tuples; empty txns gives an empty list.\n    \"\"\"\n    groups = {}\n    for txn in txns:\n        category = rules.categorize(txn, rule_list)\n        total, count = groups.get(category, (0, 0))\n        groups[category] = (total + txn[\"amount\"], count + 1)\n\n    rows = [(cat, total, count) for cat, (total, count) in groups.items()]\n    rows.sort(key=lambda row: (row[1], row[0]))\n    return rows\n\n\ndef render_report(rows):\n    \"\"\"Render summarize() output as a fixed-width text table.\n\n    Header, rule line, one line per row in the order given, second rule line,\n    grand-total line. Columns are 15/12/6 (ljust/rjust/rjust), joined with\n    newlines, no trailing newline. Empty rows still yields four lines.\n    \"\"\"\n    lines = []\n    lines.append(\"CATEGORY\".ljust(15) + \"TOTAL\".rjust(12) + \"COUNT\".rjust(6))\n    lines.append(\"-\" * 33)\n    grand = 0\n    total_count = 0\n    for category, total, count in rows:\n        lines.append(\n            category.ljust(15)\n            + money.format_amount(total).rjust(12)\n            + str(count).rjust(6)\n        )\n        grand += total\n        total_count += count\n    lines.append(\"-\" * 33)\n    lines.append(\n        \"TOTAL\".ljust(15)\n        + money.format_amount(grand).rjust(12)\n        + str(total_count).rjust(6)\n    )\n    return \"\\n\".join(lines)\n"}