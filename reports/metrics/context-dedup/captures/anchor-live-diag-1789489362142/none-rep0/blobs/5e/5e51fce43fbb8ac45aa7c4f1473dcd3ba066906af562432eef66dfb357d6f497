{"path":"money.py","content":"\"\"\"Money parsing and formatting — integer cents only.\n\nStandard library only. This module imports nothing from the project; it is the\nbottom of the dependency order. It raises only ValueError.\n\"\"\"\n\nimport re\n\n_NO_COMMA = re.compile(r\"^\\d+(\\.\\d{1,2})?$\")\n_WITH_COMMA = re.compile(r\"^\\d{1,3}(,\\d{3})+(\\.\\d{1,2})?$\")\n\n\ndef parse_amount(s):\n    \"\"\"Parse a money string into signed integer cents.\n\n    Steps (in order) per spec/01_money.md; the tables in spec/07_examples.md\n    are normative. Returns a signed int number of cents. Raises ValueError on\n    anything the spec does not accept, including a non-str argument.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"parse_amount expects a str, got %r\" % type(s).__name__)\n\n    s = s.strip()\n    if not s:\n        raise ValueError(\"empty amount\")\n\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        # Parentheses mean negative; inner text must not carry a sign.\n        negative = True\n        inner = s[1:-1].strip()\n        if inner.startswith(\"-\") or inner.startswith(\"+\"):\n            raise ValueError(\"sign inside parentheses: %r\" % s)\n        s = inner\n    elif s.startswith(\"-\"):\n        negative = True\n        s = s[1:].strip()\n    elif s.startswith(\"+\"):\n        raise ValueError(\"leading plus is never accepted\")\n\n    # Optional \"$\" only at the very start of what remains after the sign.\n    if s.startswith(\"$\"):\n        s = s[1:]\n\n    magnitude = s\n    if not _NO_COMMA.match(magnitude) and not _WITH_COMMA.match(magnitude):\n        raise ValueError(\"bad magnitude: %r\" % magnitude)\n\n    if \".\" in magnitude:\n        whole_str, frac_str = magnitude.split(\".\")\n        if len(frac_str) == 1:\n            frac_str += \"0\"\n    else:\n        whole_str, frac_str = magnitude, \"00\"\n\n    cents = int(whole_str.replace(\",\", \"\")) * 100 + int(frac_str)\n    return -cents if negative else cents\n\n\ndef format_amount(cents):\n    \"\"\"Format signed integer cents as a currency string.\n\n    Thousands separators, exactly two decimal places, leading \"$\", minus sign\n    before the \"$\" for negatives. Zero is never negative.\n    \"\"\"\n    v = abs(int(cents))\n    whole, frac = divmod(v, 100)\n    text = \"${:,}.{:02d}\".format(whole, frac)\n    if cents < 0:\n        text = \"-\" + text\n    return text\n"}