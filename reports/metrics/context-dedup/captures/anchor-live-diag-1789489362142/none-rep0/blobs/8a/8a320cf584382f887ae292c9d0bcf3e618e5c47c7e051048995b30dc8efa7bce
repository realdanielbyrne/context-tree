{"path":"rules.py","content":"\"\"\"Categorization rules.\n\nImports nothing from the project. A rules-file comment line starts with \";\";\na line starting with \"#\" is NOT a comment (stage 5 gives it tag meaning).\n\"\"\"\n\n\nclass Rule:\n    \"\"\"A single categorization rule. Do not redefine or subclass this.\"\"\"\n\n    def __init__(self, pattern, category, priority):\n        self.pattern = pattern\n        self.category = category\n        self.priority = priority\n\n    def __repr__(self):\n        return \"Rule(%r, %r, %r)\" % (self.pattern, self.category, self.priority)\n\n\ndef load_rules(text):\n    \"\"\"Parse rules TEXT (not a path) into a list of Rule, in file order.\n\n    Skips blank lines and \";\" comment lines. Raises ValueError for a line that\n    does not split on \"=\" into exactly three parts, an empty pattern, an empty\n    category, or a non-integer priority.\n    \"\"\"\n    rules = []\n    for raw_line in text.splitlines():\n        line = raw_line.strip()\n        if not line or line.startswith(\";\"):\n            continue\n        parts = line.split(\"=\")\n        if len(parts) != 3:\n            raise ValueError(\"rule must have exactly three '='-separated parts: %r\" % line)\n        pattern, category, priority_str = (p.strip() for p in parts)\n        if not pattern:\n            raise ValueError(\"empty pattern in rule: %r\" % line)\n        if not category:\n            raise ValueError(\"empty category in rule: %r\" % line)\n        priority = int(priority_str)  # non-integer raises ValueError naturally\n        rules.append(Rule(pattern, category, priority))\n    return rules\n\n\ndef categorize(txn, rules):\n    \"\"\"Return the category string for one txn.\n\n    A rule matches when its lower-cased pattern is a substring of the lower-\n    cased desc. Highest priority wins; ties go to the earlier rule in the list.\n    No match returns the literal \"uncategorized\".\n    \"\"\"\n    desc = txn[\"desc\"].lower()\n    best = None\n    for rule in rules:\n        if rule.pattern.lower() in desc:\n            if best is None or rule.priority > best.priority:\n                best = rule\n    if best is None:\n        return \"uncategorized\"\n    return best.category\n"}