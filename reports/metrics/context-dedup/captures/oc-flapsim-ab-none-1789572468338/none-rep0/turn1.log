import units, physics, world, collide

# LCG: seed 7, one advance
s = world.lcg(7)
assert s == (1103515245 * 7 + 12345) % 2147483648, s
pipe, s2 = world.spawn(0, 7)
assert pipe == {"x": 2000, "gap_top": 40 + (s >> 8) % 80, "passed": False}, pipe
assert s2 == s
assert world.spawn(1, 5) == (None, 5)

# physics: flap sets vy (not clamped), gravity clamps at VY_MAX
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 255, False) == (820, 260, True)   # 255+18=273 -> clamped 260
assert physics.step_bird(-10, 0, False)[0] == 0 and physics.step_bird(-10, 0, False)[1] == 0
y, vy, alive = physics.step_bird(1150, 0, False)
assert (y, alive) == (1120, False), (y, vy, alive)

# collision boundary cases from spec/04
assert collide.rect_overlap(0, 10, 10, 20) is False   # touching edges no
assert collide.rect_overlap(0, 10, 9, 20) is True
gap = {"x": 300, "gap_top": 40}                        # gap [40, 1040)
assert not collide.pipe_hit(40, gap)                   # top exactly at gap_top: inside
assert not collide.pipe_hit(1040 - 80, gap)            # bottom exactly gap_top+GAP_H: inside
assert collide.pipe_hit(39, gap)                       # above gap: hit
assert collide.pipe_hit(1040 - 79, gap)                # below gap: hit
p = {"x": 220, "gap_top": 40}                          # right edge exactly BIRD_X=300
assert not collide.pipe_hit(0, p)

# scroll + cull
pipes = [{"x": 100}, {"x": -120}]
world.scroll(pipes)
assert pipes[0]["x"] == 60 and pipes[1]["x"] == -160
assert world.cull(pipes) == [pipes[0]]

print("all checks passed")
