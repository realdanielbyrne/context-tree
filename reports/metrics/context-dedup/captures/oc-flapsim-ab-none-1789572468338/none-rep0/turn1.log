assert collide.rect_overlap(0, 10, 10, 20) is False
assert collide.rect_overlap(0, 10, 9, 20) is True
gap = {"x": 300, "gap_top": 40}
assert not collide.pipe_hit(40, gap)
assert not collide.pipe_hit(960, gap)
assert collide.pipe_hit(39, gap)
assert collide.pipe_hit(961, gap)
p = {"x": 180, "gap_top": 40}   # right edge exactly BIRD_X -> no overlap
assert not collide.pipe_hit(0, p)
p2 = {"x": 181, "gap_top": 40}  # one unit further: overlaps
assert collide.pipe_hit(0, p2)

pipes = [{"x": 100}, {"x": -120}]
world.scroll(pipes)
assert pipes[0]["x"] == 60 and pipes[1]["x"] == -160
assert world.cull(pipes) == [pipes[0]]

print("all checks passed")
