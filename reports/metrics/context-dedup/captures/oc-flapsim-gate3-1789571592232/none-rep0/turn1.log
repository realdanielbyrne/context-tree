import units, physics, world, collide

# size rules
for f in ("units", "physics", "world", "collide"):
    src = open(f + ".py").read()
    assert len(src.splitlines()) < 55 and len(src) < 1800, f
    assert "." not in src.replace("spec/0", "S").split("#")[0] or True

# no floats
import ast
for f in ("units", "physics", "world", "collide"):
    tree = ast.parse(open(f + ".py").read())
    for n in ast.walk(tree):
        assert not isinstance(n, ast.Constant) or not isinstance(n.value, float), (f, n.value)

# physics: flap sets vy, gravity clamps, ceiling soft, floor kills
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 250, False) == (820, 260, True)   # 250+18 clamped to 260
assert physics.step_bird(10, -27, True) == (0, 0, True)          # ceiling: y=0, vy=0
assert physics.step_bird(1150, 260, False) == (1120, 260, False) # floor kills

# world: LCG advance once per spawn; t=0 spawns
p, s = world.spawn(0, 1)
assert p is not None and s == world.lcg(1) and p["x"] == units.SPAWN_X
assert p["gap_top"] == 40 + (s >> 8) % 80
p2, s2 = world.spawn(1, 5)
assert p2 is None and s2 == 5

# scroll/cull
pipes = [{"x": 100}, {"x": -100}]
world.scroll(pipes)
assert pipes[0]["x"] == 60 and pipes[1]["x"] == -140
kept = world.cull([{"x": -120}, {"x": -119}])
assert kept == [{"x": -119}]  # x+PIPE_W <= 0 culled; -119+120=1 > 0 kept

# collide: touching edges do NOT collide
assert not collide.rect_overlap(0, 10, 10, 20)
assert collide.rect_overlap(0, 10, 5, 15)
bird = {"x": units.BIRD_X, "gap_top": 40}
assert collide.pipe_hit(40 + units.GAP_H - units.BIRD_H, bird) is False  # bottom exactly at gap bottom: inside
assert collide.pipe_hit(40 + units.GAP_H - units.BIRD_H + 1, bird) is True
far = {"x": units.BIRD_X - units.PIPE_W, "gap_top": 0}  # right edge exactly BIRD_X
assert collide.pipe_hit(0, far) is False
near = {"x": units.BIRD_X - units.PIPE_W + 1, "gap_top": 0}
assert collide.pipe_hit(0, near) is True

print("all checks passed")
