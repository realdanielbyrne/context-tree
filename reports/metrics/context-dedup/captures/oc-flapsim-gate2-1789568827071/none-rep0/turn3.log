import engine
def analyze(seed,ticks,flaps):
    tr=[]; st=engine.run(seed,ticks,flaps,False,tr)
    prev=0; passes=[]
    for (t,y,vy,s,a) in tr:
        if s>prev: passes.append((t,s-prev,vy))
        prev=s
    return st,passes
# search for runs that pass 1-3 pipes then die on a pipe
cands=[]
for seed in range(1,30):
    for flaps in ['0010','0100','1000','0001','0110','1100','0101','1010','1001','0111','1101','1011','0011','0111','1110']:
        st,pv=analyze(seed,200,flaps)
        if not st['alive'] and 0<st['score']<8:
            cands.append((seed,flaps,st['score'],st['ticks_run'],pv))
for c in cands[:15]: print(c)
print('total:',len(cands))
