import physics, world, collide as c
assert c.rect_overlap(300, 380, 380, 500) is False   # pipe right edge at BIRD_X: no overlap
assert c.pipe_hit(960, {'x': 300, 'gap_top': 40}) is False  # bottom exactly gap_top+GAP_H -> inside
assert c.pipe_hit(961, {'x': 300, 'gap_top': 40}) is True
assert c.pipe_hit(39, {'x': 300, 'gap_top': 40}) is True    # top above gap
y, vy, a = physics.step_bird(-5, -10, True); assert (y, vy, a) == (0, 0, True)   # ceiling soft
y, vy, a = physics.step_bird(1200, 0, False); assert (y, vy, a) == (1120, 18, False)  # floor kills
y, vy, a = physics.step_bird(560, 260, False); assert (y, vy, a) == (820, 260, True) # gravity clamped
y, vy, a = physics.step_bird(560, 300, True);  assert (y, vy, a) == (533, -27, True) # flap never clamped
assert world.lcg(1) == (1103515245 + 12345) % 2147483648
p, s = world.spawn(45, 1); assert p['x'] == 2000 and 40 <= p['gap_top'] < 120 and p['passed'] is False
assert world.spawn(46, s) == (None, s)
ps = [{'x': -120}, {'x': -100}]
assert world.cull(ps) == [{'x': -100}]
world.scroll(ps); assert ps[0]['x'] == -160
print('all ok')
