+class ShieldTests(unittest.TestCase):
+    def test_shields_key_only_with_powerups(self):
+        plain = run_quiet(7, 5, "0")
+        shielded = run_quiet(7, 5, "0", powerups=True)
+        self.assertNotIn("shields", plain)
+        self.assertEqual(shielded["shields"], 1)
+        for key in ("y", "vy", "score", "alive", "ticks_run"):
+            self.assertEqual(plain[key], shielded[key])
+
+    def test_shield_absorbs_first_hit_rehit_drains(self):
+        # pipe 1 overlaps the ceiling-stuck bird on ticks 40..44; the first hit
+        # spends the only shield and the re-hit one tick later kills, because
+        # collision is evaluated against every pipe each tick (spec/04 + spec/07)
+        self.assertEqual(run_quiet(7, 120, "01")["ticks_run"], 41)
+        st = run_quiet(7, 120, "01", powerups=True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 42)
+        self.assertEqual(st["shields"], 0)
+
+    def test_floor_kill_ignores_shields(self):
+        st = run_quiet(2, 90, "0", powerups=True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 8)
+        self.assertEqual(st["y"], FIELD_H - BIRD_H)
+        self.assertEqual(st["shields"], 1)
+
+    def test_shield_grant_every_fifth_pipe(self):
+        # six pipes passed by t=299; the 5th one grants a shield
+        st = run_quiet(7, 300, "0010", powerups=True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 12)
+        self.assertEqual(st["shields"], 2)
+
+    def test_shield_cap_at_three(self):
+        # fifteen pipes passed; grants at the 5th, 10th and 15th stay capped
+        st = run_quiet(7, 700, "0010", powerups=True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 30)
+        self.assertEqual(st["shields"], 3)
+
+    def test_trace_lines_unchanged_with_powerups(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            engine.run(7, 50, "0010")
+        plain = out.getvalue()
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            engine.run(7, 50, "0010", powerups=True)
+        self.assertEqual(plain, out.getvalue())
+
+    def test_digest_shields_field(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            flapsim.main(["--seed", "7", "--ticks", "200", "--flaps", "0010",
+                          "--powerups"])
+        self.assertEqual(
+            out.getvalue().splitlines()[-1],
+            "DIGEST seed=7 ticks=200 score=8 alive=1 y=0578 vy=-0009 "
+            "ticks_run=200 shields=1")
+
+
 if __name__ == "__main__":
     unittest.main()

