import re, subprocess

doc = open("GETTING_STARTED.md").read()

# 1. every quoted def line must appear verbatim in its module file
quoted_defs = ["def step_bird(y, vy, flap):", "def lcg(s):", "def spawn(t, s):",
               "def scroll(pipes):", "def cull(pipes):",
               "def rect_overlap(a0, a1, b0, b1):", "def pipe_hit(y, pipe):",
               "def run(seed, ticks, flaps, powerups=False):",
               "def parse(argv):", "def selfcheck():", "def main(argv):"]
for d in quoted_defs:
    assert d in doc, "missing from doc: " + d
src = {m: open(m).read() for m in ("units.py","physics.py","world.py","collide.py","engine.py","flapsim.py")}
assert "FIELD_H = 1200" in src["units.py"] and "FIELD_H = 1200" in doc
for d in quoted_defs:
    assert any(d in s for s in src.values()), "not in any module: " + d
print("quoted def lines: all match the files character for character")

# 2. demo output block in the doc == replay.txt
block = re.search(r"```\n(TRACE.*?)\n```", doc, re.S).group(1)
assert block == open("replay.txt").read().rstrip("\n"), "demo block differs from replay.txt"
print("doc demo block: identical to replay.txt")

# 3. powerups DIGEST example in the doc == actual output
out = subprocess.run(["python3","flapsim.py","--seed","7","--ticks","200",
                      "--flaps","0010","--powerups"], capture_output=True, text=True).stdout
line = out.splitlines()[-1]
assert line in doc, "doc powerups DIGEST differs: " + line
print("doc powerups DIGEST: matches actual output")
