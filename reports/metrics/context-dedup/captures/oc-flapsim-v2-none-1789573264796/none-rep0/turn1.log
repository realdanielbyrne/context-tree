assert collide.pipe_hit(960, {"x": 300, "gap_top": 40}) is False   # bottom exactly gap_bottom -> inside
assert collide.pipe_hit(961, {"x": 300, "gap_top": 40}) is True
assert collide.pipe_hit(560, {"x": 180, "gap_top": 40}) is False   # pipe right edge exactly BIRD_X

assert physics.step_bird(-5, 0, True) == (0, 0, True)      # flap into ceiling: soft, vy zeroed
assert physics.step_bird(1200, 0, False) == (1120, 18, False)
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 255, False) == (802, 260, True)

s = world.lcg(1)
assert s == (1103515245 + 12345) % 2147483648
p, s2 = world.spawn(0, 1)
assert p is not None and p["x"] == 2000 and p["passed"] is False and s2 == world.lcg(1)
assert world.spawn(1, 1)[0] is None
pipes = [{"x": -120}, {"x": -119}]
world.scroll(pipes)
assert world.cull(pipes) == [{"x": -159}]

seq = [world.spawn(45 * i, 7)[1] for i in range(3)]
assert seq == [world.lcg(7), world.lcg(world.lcg(7)), world.lcg(world.lcg(world.lcg(7)))]
print("all checks passed")
