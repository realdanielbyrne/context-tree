+class TestShields(unittest.TestCase):
+    def test_shields_key_only_with_powerups(self):
+        plain = run(7, 200, "0010")
+        armed = run(7, 200, "0010", powerups=True)
+        self.assertNotIn("shields", plain)
+        for k, v in plain.items():
+            self.assertEqual(armed[k], v)
+        self.assertEqual(armed["shields"], 1)
+
+    def test_shield_absorbs_pipe_hit(self):
+        # without powerups the bird dies at t=40; the shield buys one more tick
+        plain = run(7, 120, "01")
+        armed = run(7, 120, "01", powerups=True)
+        self.assertEqual(plain["ticks_run"], 41)
+        self.assertFalse(armed["alive"])
+        self.assertGreater(armed["ticks_run"], plain["ticks_run"])
+        self.assertEqual(armed["shields"], 0)
+        self.assertEqual(armed["score"], 0)
+
+    def test_floor_kill_not_prevented_by_shield(self):
+        st = run(2, 90, "0", powerups=True)
+        self.assertFalse(st["alive"])
+        self.assertEqual(st["ticks_run"], 8)
+        self.assertEqual(st["shields"], 1)
+
+    def test_fifth_pipe_passed_grants_shield(self):
+        st = run(7, 226, "0010", powerups=True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 10)
+        self.assertEqual(st["shields"], 2)
+
+    def test_shields_capped_at_3(self):
+        st = run(7, 766, "0010", powerups=True)
+        self.assertTrue(st["alive"])
+        self.assertEqual(st["score"], 34)
+        self.assertEqual(st["shields"], 3)
+
+
 if __name__ == "__main__":
     unittest.main()

