# half-open: bird bottom exactly at gap end -> inside, survives
assert collide.pipe_hit(560, H(350, -360)) is False  # gap [-360,640), bottom=640
# half-open: bird top exactly at gap start -> inside, survives
assert collide.pipe_hit(560, H(350, 560)) is False   # gap [560,1560)
# pipe right edge exactly BIRD_X -> no overlap
assert collide.pipe_hit(2000, H(180, 0)) is False    # [180,300) touches [300,380)
# rect_overlap basics
assert collide.rect_overlap(0, 10, 10, 20) is False
assert collide.rect_overlap(0, 10, 9, 20) is True
print("all checks passed")
