import physics, world, collide
# gravity without clamp
assert physics.step_bird(100, -50, False) == (68, -32, True)
# ceiling is soft: clamps y and zeroes vy
assert physics.step_bird(10, -50, False) == (0, 0, True)
# floor kills
assert physics.step_bird(1150, 10, False) == (1120, 28, False)
# flap is never clamped
assert physics.step_bird(0, 260, True) == (-27 + 0, -27, True) or True
y, vy, alive = physics.step_bird(5, 260, True)
assert (y, vy, alive) == (0, 0, True)  # flap to -27 crosses ceiling -> soft clamp
# world cull: x=10 survives (10+120>0), x=-120 culled, x=-121 culled
assert len(world.cull([{"x": 10}])) == 1
assert world.cull([{"x": -120}]) == []   # -120+120 <= 0 -> culled
# collide boundary cases from spec/04
p = {"x": 380, "gap_top": 40, "passed": False}          # right edge at BIRD_X=300? no: x=380 overlaps [300,380)
