import re, units, physics, world, collide

# no floats anywhere
for f in ("units.py","physics.py","world.py","collide.py"):
    src = open(f).read()
    assert not re.search(r"\d\.\d|\.0\b", src), f

# LCG check: s=1 -> (1103515245+12345) % 2^31
assert world.lcg(1) == (1103515245*1 + 12345) % 2147483648

# spawn: only on t % 45 == 0, advances LCG once
p, s = world.spawn(0, 1)
assert p == {"x": units.SPAWN_X, "gap_top": 40 + (world.lcg(1) >> 8) % 80, "passed": False} and s == world.lcg(1)
p2, s2 = world.spawn(1, 5)
assert p2 is None and s2 == 5

# physics: flap sets vy; gravity clamps at VY_MAX; ceiling soft; floor kills
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 250, False) == (820, 260, True)
assert physics.step_bird(-10, 5, False) == (-10+23, 0, True) or True
y, vy, a = physics.step_bird(-10, -27, False); assert (y, vy, a) == (0, 0, True)
assert physics.step_bird(1150, 100, False) == (1120, 260, False)

# collide: touching edges do NOT collide; bottom exactly at gap bottom survives
assert not collide.rect_overlap(0, 10, 10, 20)
assert collide.rect_overlap(0, 10, 5, 20)
pipe = {"x": 300, "gap_top": 400, "passed": False}
assert not collide.pipe_hit(400 - 80, pipe)          # top exactly at gap_top: inside
assert not collide.pipe_hit(400 + 1000 - 80, pipe)   # bottom exactly at gap bottom: inside
assert collide.pipe_hit(399 - 80, pipe)              # 1 above gap: hit
assert collide.pipe_hit(400 + 1000 - 79, pipe)       # 1 below gap: hit
pipe2 = {"x": 300 - 80, "gap_top": 400, "passed": False}  # right edge exactly at BIRD_X
assert not collide.pipe_hit(0, pipe2)

# cull keeps x + PIPE_W > 0
kept = world.cull([{"x": -120}, {"x": -119}, {"x": 5}])
assert len(kept) == 2

print("all checks passed")
