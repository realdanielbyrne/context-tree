import units, physics, world, collide

# size limits
for name in ("units", "physics", "world", "collide"):
    src = open(name + ".py").read()
    lines = src.count("\n")
    assert lines < 55 and len(src) < 1800, (name, lines, len(src))
    print(f"{name}: {lines} lines, {len(src)} chars OK")

# no floats in source
for name in ("units", "physics", "world", "collide"):
    import ast
    tree = ast.parse(open(name + ".py").read())
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, float):
            raise AssertionError(f"float literal in {name}")
print("integers only OK")

# physics: flap sets vy, gravity clamps, ceiling soft, floor kills
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(560, 250, False) == (820, 260, True)   # clamp at VY_MAX
assert physics.step_bird(10, -50, False) == (28, -32, True)
y, vy, alive = physics.step_bird(-5, 0, False); assert (y, vy, alive) == (0, 0, True)
y, vy, alive = physics.step_bird(1200, 0, False); assert (y, vy, alive) == (1120, 18, False)

# world: LCG + spawn only on t % 45 == 0, advances once per spawn
assert world.lcg(1) == (1103515245 * 1 + 12345) % 2147483648
p, s = world.spawn(45, 1); assert p["x"] == units.SPAWN_X and p["passed"] is False
assert p["gap_top"] == 40 + (s >> 8) % 80 and 40 <= p["gap_top"] < 120
p2, s2 = world.spawn(46, s); assert p2 is None and s2 == s

# scroll/cull
pipes = [{"x": 50, "gap_top": 40, "passed": False}, {"x": 300, "gap_top": 40, "passed": False}]
world.scroll(pipes)
assert [p["x"] for p in pipes] == [10, 260]
assert world.cull(pipes)[0]["x"] == 260  # x+PIPE_W=270 > 0 kept; 10+120=130 also kept
assert world.cull([{"x": -120, "gap_top": 0, "passed": True}]) == []  # exactly at edge culled

# collide boundary cases from spec
pipe = {"x": 380, "gap_top": 400, "passed": False}
assert not collide.rect_overlap(300, 380, 380, 500)      # right edge exactly BIRD_X: no overlap
assert collide.pipe_hit(400 - 80 + 1, pipe)              # top just above gap_top... wait y+? use outside-top case
# bird bottom exactly at gap_top + GAP_H -> INSIDE, survives
assert not collide.pipe_hit(400 + 1000 - 80, pipe)
# bird top exactly at gap_top -> inside (y < gap_top is False)
assert not collide.pipe_hit(400, pipe)
# one centi-unit above the gap -> hit
assert collide.pipe_hit(399, pipe)
# one centi-unit below the gap bottom -> hit
assert collide.pipe_hit(400 + 1000 - 80 + 1, pipe)
print("all smoke tests passed")
EOF
