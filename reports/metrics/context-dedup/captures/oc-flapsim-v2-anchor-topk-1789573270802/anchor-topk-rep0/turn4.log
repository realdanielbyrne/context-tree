import engine, random
random.seed(0)
bad = 0
for trial in range(2000):
    seed = random.randrange(1, 10**6)
    ticks = random.randrange(0, 400)
    L = random.randrange(1, 9)
    flaps = "".join(random.choice("01") for _ in range(L))
    seen = []
    st = engine.run(seed, ticks, flaps, trace=lambda t,y,vy,s,a: seen.append((t,y,vy,s,a)))
    # score non-decreasing
    scores = [s for (_,_,_,s,_) in seen]
    if any(b < a for a, b in zip(scores, scores[1:])): bad += 1; print("score decreased", seed, flaps)
    # ticks_run == len(seen) (one trace per executed tick) and <= ticks
    if st["ticks_run"] != len(seen) or st["ticks_run"] > ticks: bad += 1; print("ticks_run mismatch", seed, flaps, st["ticks_run"], len(seen))
    # alive consistent with last trace
    if bool(seen[-1][4]) != st["alive"] if seen else st["alive"] != True: bad += 1; print("alive mismatch", seed, flaps)
    # y within [0, FIELD_H-BIRD_H]
    if not (0 <= st["y"] <= 1200 - 80): bad += 1; print("y out of range", seed, flaps, st["y"])
    # final trace tick == ticks_run-1
    if seen and seen[-1][0] != st["ticks_run"] - 1: bad += 1; print("final trace tick wrong", seed, flaps)
print("invariant violations:", bad)
