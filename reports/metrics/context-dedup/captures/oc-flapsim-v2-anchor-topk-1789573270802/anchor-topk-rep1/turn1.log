import physics, world, collide

# --- physics (hand-computed) ---
# flap: vy=-27, y=560-27=533
assert physics.step_bird(560, 0, True) == (533, -27, True)
# gravity at terminal: min(260+18,260)=260; y=1380 -> floor: y=1120, dead
assert physics.step_bird(1120, 260, False) == (1120, 260, False)
# y=1150+18=1168; 1168+80=1248>1200 -> dead at y=1120
assert physics.step_bird(1150, 0, False) == (1120, 18, False)
# y=1102+18=1120; 1120+80=1200 not > 1200 -> alive
assert physics.step_bird(1102, 0, False) == (1120, 18, True)
# y=1103+18=1121; 1121+80=1201>1200 -> dead
assert physics.step_bird(1103, 0, False) == (1120, 18, False)
# ceiling: y=10-27=-17 <0 -> y=0, vy=0
assert physics.step_bird(10, 0, True) == (0, 0, True)
# gravity from negative: y=-5+18=13, no ceiling trigger
assert physics.step_bird(-5, 0, False) == (13, 18, True)

# --- world ---
assert world.lcg(7) == (1103515245 * 7 + 12345) % 2147483648
p, s2 = world.spawn(0, 7)
assert p == {"x": 2000, "gap_top": 40 + (s2 >> 8) % 80, "passed": False}
assert world.spawn(44, 7) == (None, 7) and world.spawn(45, 7)[1] != 7
pipes = [{"x": 50}, {"x": 300}]
world.scroll(pipes)
assert [q["x"] for q in pipes] == [10, 260]
assert world.cull([{"x": -120}]) == []          # x+W == 0 -> culled
assert world.cull([{"x": -119}]) != []          # x+W == 1 -> kept

# --- collide (spec boundary cases) ---
assert collide.rect_overlap(0, 10, 10, 20) is False   # touching edges: no overlap
assert collide.rect_overlap(0, 10, 5, 15) is True
pipe = {"x": 380, "gap_top": 400}                     # right edge == BIRD_X -> no overlap
assert collide.pipe_hit(500, pipe) is False
pipe = {"x": 300, "gap_top": 400}                     # bird [300,380)x[y,y+80), gap [400,1400)
assert collide.pipe_hit(500, pipe) is False           # fully inside gap -> no hit
assert collide.pipe_hit(392, pipe) is True            # y < gap_top -> hit (top pipe)
assert collide.pipe_hit(1320, pipe) is True           # 1400 > 1400? no: 1320+80=1400 not > -> inside!
print("all core checks passed")
EOF
