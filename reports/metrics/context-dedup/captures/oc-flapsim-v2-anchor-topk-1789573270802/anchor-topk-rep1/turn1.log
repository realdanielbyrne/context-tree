import units, physics, world, collide

# physics: flap sets vy (never clamped), gravity clamps at VY_MAX
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(1120, 260, False) == (1120, 260, False)  # floor kills, clamps y
assert physics.step_bird(1150, 0, False) == (1120, 18, False)     # 1150+18=1168, +80 > 1200
assert physics.step_bird(-5, 0, False) == (0, 0, True)            # ceiling soft, zeroes vy

# lcg + spawn: advance once per spawn; no spawn off-tick
s1 = world.lcg(7)
assert s1 == (1103515245 * 7 + 12345) % 2147483648
p, s2 = world.spawn(0, 7)
assert p == {"x": 2000, "gap_top": 40 + (s2 >> 8) % 80, "passed": False}
assert world.spawn(1, 7) == (None, 7)

# scroll/cull
pipes = [{"x": 50, "gap_top": 100, "passed": True}, {"x": 300, "gap_top": 100, "passed": False}]
world.scroll(pipes)
assert [p["x"] for p in pipes] == [10, 260]
assert world.cull([{"x": -120, "gap_top": 0, "passed": True}]) == []          # x+W == 0 -> culled
assert len(world.cull([{"x": -119, "gap_top": 0, "passed": True}])) == 1      # x+W > 0 -> kept

# collide: touching edges do NOT collide; bottom exactly at gap bottom survives
assert collide.rect_overlap(0, 10, 10, 20) is False
assert collide.rect_overlap(0, 10, 5, 15) is True
pipe = {"x": 300, "gap_top": 400, "passed": False}
assert collide.pipe_hit(400, pipe) is True                                   # in gap, survives? no: 400 < gap_top -> outside top... wait
