import units, physics, world, collide

# physics
assert physics.step_bird(560, 0, True) == (533, -27, True)      # flap sets vy
assert physics.step_bird(1120, 260, False) == (1120, 260, False)  # floor kills, y clamped
assert physics.step_bird(1150, 0, False) == (1120, 18, False)   # 1168+80 > 1200 -> dies
assert physics.step_bird(1132, 0, False) == (1150, 18, True)    # 1150+80 == 1200 -> survives
assert physics.step_bird(10, 0, True) == (0, 0, True)           # ceiling soft, zeroes vy
assert physics.step_bird(0, -27, False) == (0, 0, True)         # at ceiling, gravity: y=-17 -> 0

# lcg + spawn
s1 = world.lcg(7)
assert s1 == (1103515245 * 7 + 12345) % 2147483648
p, s2 = world.spawn(0, 7)
assert p == {"x": 2000, "gap_top": 40 + (s2 >> 8) % 80, "passed": False}
assert world.spawn(1, 7) == (None, 7)                            # off-tick: no advance

# scroll/cull
pipes = [{"x": 50, "gap_top": 100, "passed": True}, {"x": 300, "gap_top": 100, "passed": False}]
world.scroll(pipes)
assert [q["x"] for q in pipes] == [10, 260]
assert world.cull([{"x": -120, "gap_top": 0, "passed": True}]) == []   # x+W == 0 -> culled
assert len(world.cull([{"x": -119, "gap_top": 0, "passed": True}])) == 1

# collide: touching edges do NOT collide
assert collide.rect_overlap(0, 10, 10, 20) is False
assert collide.rect_overlap(0, 10, 5, 15) is True
pipe = {"x": 380, "gap_top": 400, "passed": False}              # right edge at BIRD_X -> no overlap
assert collide.pipe_hit(500, pipe) is False
pipe = {"x": 299, "gap_top": 400, "passed": False}
assert collide.pipe_hit(1300, pipe) is False                    # below gap bottom: y=1300 > 1400? no -> hit... check below
pipe = {"x": 300, "gap_top": 400, "passed": False}              # [300,420) x [400,1400)
assert collide.pipe_hit(500, pipe) is True                      # y in gap -> outside False -> no hit? NO: 500>=400 and 580<=1400 -> inside -> False
