import physics, world, collide

assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(1120, 260, False) == (1120, 260, False)
assert physics.step_bird(1150, 0, False) == (1120, 18, False)
assert physics.step_bird(1102, 0, False) == (1120, 18, True)   # bottom exactly at floor: alive
assert physics.step_bird(1103, 0, False) == (1120, 18, False)
assert physics.step_bird(10, 0, True) == (0, 0, True)          # ceiling soft, vy zeroed

assert world.lcg(7) == (1103515245 * 7 + 12345) % 2147483648
p, s2 = world.spawn(0, 7)
assert p == {"x": 2000, "gap_top": 40 + (s2 >> 8) % 80, "passed": False}
assert world.spawn(44, 7) == (None, 7) and world.spawn(45, 7)[1] != 7
pipes = [{"x": 50}, {"x": 300}]
world.scroll(pipes)
assert [q["x"] for q in pipes] == [10, 260]
assert world.cull([{"x": -120}]) == []          # x+W == 0 -> culled
assert world.cull([{"x": -119}]) != []          # x+W == 1 -> kept

assert collide.rect_overlap(0, 10, 10, 20) is False   # touching edges: no overlap
assert collide.rect_overlap(0, 10, 5, 15) is True
pipe = {"x": 380, "gap_top": 400}                     # right edge == BIRD_X -> no overlap
assert collide.pipe_hit(500, pipe) is False
pipe = {"x": 300, "gap_top": 400}                     # gap [400,1400)
assert collide.pipe_hit(500, pipe) is False           # inside gap -> survives
assert collide.pipe_hit(392, pipe) is True            # y < gap_top -> top pipe hit
assert collide.pipe_hit(1320, pipe) is False          # bottom exactly at 1400 -> inside, survives
assert collide.pipe_hit(1321, pipe) is True           # bottom 1401 > 1400 -> bottom pipe hit

# no floats anywhere, all modules import cleanly with no side effects
import ast, sys
for f in ("units.py", "physics.py", "world.py", "collide.py"):
    tree = ast.parse(open(f).read())
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, float):
            raise SystemExit("float literal in " + f)
print("all core checks passed")
