(533, -27, True)
"""Per-tick bird physics."""
from units import BIRD_H, FIELD_H, FLAP_V, G, VY_MAX


def step_bird(y, vy, flap):
    """Advance the bird one tick. Returns (y, vy, alive)."""
    if flap:
        vy = FLAP_V
    else:
        vy = min(vy + G, VY_MAX)
    y += vy
    alive = True
    if y < 0:
        y = 0
        vy = 0
    if y + BIRD_H > FIELD_H:
        y = FIELD_H - BIRD_H
        alive = False
    return y, vy, alive
