{"path":"flapsim.py","content":"\"\"\"Command line for flapsim: hand-parsed argv, exact output formats.\"\"\"\n\nimport sys\nfrom engine import run\n\n\ndef parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps by hand. Returns (seed, ticks, flaps).\"\"\"\n    seed, ticks, flaps = 0, 0, \"0\"\n    i = 1\n    while i < len(argv):\n        a = argv[i]\n        if a == \"--seed\":\n            seed = int(argv[i + 1]); i += 2\n        elif a == \"--ticks\":\n            ticks = int(argv[i + 1]); i += 2\n        elif a == \"--flaps\":\n            flaps = argv[i + 1]; i += 2\n        else:\n            raise SystemExit(\"unknown flag: \" + a)\n    return seed, ticks, flaps\n\n\ndef trace(t, y, vy, score, alive):\n    return (\"TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d\"\n            % (t, y, vy, score, 1 if alive else 0))\n\n\ndef digest(seed, ticks, st):\n    return (\"DIGEST seed=%d ticks=%d score=%d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"],\n                              1 if st[\"alive\"] else 0, st[\"y\"], st[\"vy\"],\n                              st[\"ticks_run\"]))\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps = parse(argv)\n    st, traces = run(seed, ticks, flaps)\n    for t, y, vy, score, alive in traces:\n        print(trace(t, y, vy, score, alive))\n    print(digest(seed, ticks, st))\n\n\ndef selfcheck():\n    cases = [(\"EX1\", 7, 200, \"0010\", 8, 1), (\"EX2\", 7, 120, \"01\", 0, 0),\n             (\"EX3\", 3, 200, \"0001\", 8, 1), (\"EX4\", 11, 60, \"1\", 0, 0),\n             (\"EX5\", 2, 90, \"0\", 0, 0), (\"EX6\", 5, 200, \"0010\", 8, 1)]\n    for name, seed, ticks, flaps, escore, ealive in cases:\n        st, _ = run(seed, ticks, flaps)\n        ok = \"OK\" if (st[\"score\"] == escore and\n                      (1 if st[\"alive\"] else 0) == ealive) else \"FAIL\"\n        print(\"%s seed=%d ticks=%d flaps=%s expect score=%02d alive=%d \"\n              \"got score=%02d alive=%d %s\"\n              % (name, seed, ticks, flaps, escore, ealive, st[\"score\"],\n                 1 if st[\"alive\"] else 0, ok))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv)\n"}