{"path":"flapsim.py","old_str":"def digest(seed, ticks, st):\n    a = 1 if st[\"alive\"] else 0\n    return (\"DIGEST seed=%d ticks=%d score=%d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"], a, st[\"y\"],\n                              st[\"vy\"], st[\"ticks_run\"]))\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps = parse(argv)\n    st, traces = run(seed, ticks, flaps)\n    for row in traces:\n        print(trace(*row))\n    print(digest(seed, ticks, st))","new_str":"def digest(seed, ticks, st):\n    a = 1 if st[\"alive\"] else 0\n    d = (\"DIGEST seed=%d ticks=%d score=%d alive=%d y=%04d vy=%+05d \"\n         \"ticks_run=%d\" % (seed, ticks, st[\"score\"], a, st[\"y\"],\n                           st[\"vy\"], st[\"ticks_run\"]))\n    if \"shields\" in st:\n        d += \" shields=%d\" % st[\"shields\"]\n    return d\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps, powerups = parse(argv)\n    st, traces = run(seed, ticks, flaps, powerups=powerups)\n    for row in traces:\n        print(trace(*row))\n    print(digest(seed, ticks, st))"}