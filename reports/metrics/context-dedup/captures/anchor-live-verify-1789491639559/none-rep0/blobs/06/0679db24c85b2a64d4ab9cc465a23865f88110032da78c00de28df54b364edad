"""Command line for flapsim: hand-parsed argv, exact output formats."""

import sys
from engine import run


def parse(argv):
    """Parse flags by hand. Returns (seed, ticks, flaps, powerups)."""
    vals = {"--seed": 0, "--ticks": 0, "--flaps": "0"}
    pu = False
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--powerups":
            pu = True; i += 1
        elif a in vals:
            vals[a] = int(argv[i + 1]) if a != "--flaps" else argv[i + 1]; i += 2
        else:
            raise SystemExit("unknown flag: " + a)
    return vals["--seed"], vals["--ticks"], vals["--flaps"], pu


def trace(t, y, vy, score, alive):
    return "TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d" % (t, y, vy, score, 1 if alive else 0)


def digest(seed, ticks, st):
    a = 1 if st["alive"] else 0
    d = ("DIGEST seed=%d ticks=%d score=%d alive=%d y=%04d vy=%+05d "
         "ticks_run=%d" % (seed, ticks, st["score"], a, st["y"], st["vy"], st["ticks_run"]))
    if "shields" in st:
        d += " shields=%d" % st["shields"]
    return d


def main(argv):
    if len(argv) == 2 and argv[1] == "--selfcheck":
        return selfcheck()
    seed, ticks, flaps, powerups = parse(argv)
    st, traces = run(seed, ticks, flaps, powerups=powerups)
    for row in traces:
        print(trace(*row))
    print(digest(seed, ticks, st))

