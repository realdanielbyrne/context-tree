{"path":"physics.py","content":"\"\"\"Per-tick bird physics: flap/gravity, integration, ceiling and floor.\"\"\"\n\nfrom units import G, FLAP_V, VY_MAX, FIELD_H, BIRD_H\n\n\ndef step_bird(y, vy, flap):\n    \"\"\"Advance the bird one tick. Returns (y, vy, alive).\n\n    A flap SETS vy to FLAP_V (never clamped); otherwise gravity is added and\n    clamped at VY_MAX. The ceiling is soft (clamps y, zeroes vy); the floor\n    kills the bird but does not zero vy.\n    \"\"\"\n    if flap:\n        vy = FLAP_V\n    else:\n        vy = min(vy + G, VY_MAX)\n    y += vy\n    alive = True\n    if y < 0:\n        y = 0\n        vy = 0\n    elif y + BIRD_H > FIELD_H:\n        y = FIELD_H - BIRD_H\n        alive = False\n    return y, vy, alive\n"}