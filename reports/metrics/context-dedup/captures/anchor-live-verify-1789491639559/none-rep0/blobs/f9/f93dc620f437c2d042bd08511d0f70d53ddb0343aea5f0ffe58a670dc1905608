{"path":"flapsim.py","content":"\"\"\"Command line for flapsim: hand-parsed argv, exact output formats.\"\"\"\n\nimport sys\nfrom engine import run\n\n\ndef parse(argv):\n    \"\"\"Parse --seed/--ticks/--flaps by hand. Returns (seed, ticks, flaps).\"\"\"\n    seed, ticks, flaps = 0, 0, \"0\"\n    i = 1\n    while i < len(argv):\n        a = argv[i]\n        if a == \"--seed\":\n            seed = int(argv[i + 1]); i += 2\n        elif a == \"--ticks\":\n            ticks = int(argv[i + 1]); i += 2\n        elif a == \"--flaps\":\n            flaps = argv[i + 1]; i += 2\n        else:\n            raise SystemExit(\"unknown flag: \" + a)\n    return seed, ticks, flaps\n\n\ndef trace(t, st):\n    return (\"TRACE t=%04d y=%04d vy=%+05d score=%02d alive=%d\"\n            % (t, st[\"y\"], st[\"vy\"], st[\"score\"], 1 if st[\"alive\"] else 0))\n\n\ndef digest(seed, ticks, st):\n    return (\"DIGEST seed=%d ticks=%d score=%d alive=%d y=%04d vy=%+05d \"\n            \"ticks_run=%d\" % (seed, ticks, st[\"score\"],\n                              1 if st[\"alive\"] else 0, st[\"y\"], st[\"vy\"],\n                              st[\"ticks_run\"]))\n\n\ndef main(argv):\n    if len(argv) == 2 and argv[1] == \"--selfcheck\":\n        return selfcheck()\n    seed, ticks, flaps = parse(argv)\n    every = max(1, ticks // 20)\n    y, vy, score, alive = 560, 0, 0, True\n    pipes, s, n = [], seed, 0\n    while n < ticks and alive:\n        t = n\n        if t % 45 == 0:\n            from world import spawn as _sp\n            s, pipe = _sp(t, s)\n            if pipe is not None:\n                pipes.append(pipe)\n        flap = flaps[t % len(flaps)] == \"1\"\n        from physics import step_bird\n        y, vy, alive = step_bird(y, vy, flap)\n        from world import scroll as _sc\n        _sc(pipes)\n        from collide import pipe_hit\n        for p in pipes:\n            if pipe_hit(y, p):\n                alive = False\n                break\n        if alive:\n            from engine import _score\n            score = _score(y, vy, pipes, score)\n        from world import cull as _cu\n        pipes = _cu(pipes)\n        n += 1\n        if t % every == 0:\n            print(trace(t, {\"y\": y, \"vy\": vy, \"score\": score, \"alive\": alive}))\n    print(digest(seed, ticks, {\"y\": y, \"vy\": vy, \"score\": score,\n                               \"alive\": alive, \"ticks_run\": n}))\n\n\ndef selfcheck():\n    cases = [(\"EX1\", 7, 200, \"0010\", 8, 1), (\"EX2\", 7, 120, \"01\", 0, 0),\n             (\"EX3\", 3, 200, \"0001\", 8, 1), (\"EX4\", 11, 60, \"1\", 0, 0),\n             (\"EX5\", 2, 90, \"0\", 0, 0), (\"EX6\", 5, 200, \"0010\", 8, 1)]\n    for name, seed, ticks, flaps, escore, ealive in cases:\n        st = run(seed, ticks, flaps)\n        ok = \"OK\" if (st[\"score\"] == escore and\n                      (1 if st[\"alive\"] else 0) == ealive) else \"FAIL\"\n        print(\"%s seed=%d ticks=%d flaps=%s expect score=%02d alive=%d \"\n              \"got score=%02d alive=%d %s\"\n              % (name, seed, ticks, flaps, escore, ealive, st[\"score\"],\n                 1 if st[\"alive\"] else 0, ok))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv)\n"}