{"path":"engine.py","content":"\"\"\"The deterministic run loop, following the per-tick order in spec/02.\"\"\"\n\nfrom units import BIRD_X, PIPE_W, GLIDE_VY, SPAWN_EVERY\nfrom physics import step_bird\nfrom world import spawn, scroll, cull\nfrom collide import pipe_hit\n\n\ndef _score(y, vy, pipes, score):\n    \"\"\"Step 5: score any pipe whose right edge is at or behind the bird.\"\"\"\n    for p in pipes:\n        if not p[\"passed\"] and p[\"x\"] + PIPE_W <= BIRD_X:\n            p[\"passed\"] = True\n            score += 1\n            if abs(vy) <= GLIDE_VY:\n                score += 1\n    return score\n\n\ndef run(seed, ticks, flaps=\"0\", powerups=False):\n    \"\"\"Run the simulation; return (state_dict, trace_ticks).\n\n    trace_ticks is a list of (t, y, vy, score, alive) snapshots taken at the\n    END of each tick where t % max(1, ticks//20) == 0.\n    \"\"\"\n    y, vy, score, alive = 560, 0, 0, True\n    pipes, s, n, traces = [], seed, 0, []\n    every = max(1, ticks // 20)\n    while n < ticks and alive:\n        t = n\n        if t % SPAWN_EVERY == 0:\n            s, pipe = spawn(t, s)\n            if pipe is not None:\n                pipes.append(pipe)\n        flap = flaps[t % len(flaps)] == \"1\"\n        y, vy, alive = step_bird(y, vy, flap)\n        scroll(pipes)\n        for p in pipes:\n            if pipe_hit(y, p):\n                alive = False\n                break\n        if alive:\n            score = _score(y, vy, pipes, score)\n        pipes = cull(pipes)\n        n += 1\n        if t % every == 0:\n            traces.append((t, y, vy, score, alive))\n    state = {\"y\": y, \"vy\": vy, \"score\": score, \"alive\": alive,\n             \"ticks_run\": n}\n    return state, traces\n"}