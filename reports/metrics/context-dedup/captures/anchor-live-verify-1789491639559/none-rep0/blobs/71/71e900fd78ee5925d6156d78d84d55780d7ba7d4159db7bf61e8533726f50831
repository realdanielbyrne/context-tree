{"path":"collide.py","content":"\"\"\"Axis-aligned collision with half-open intervals. Touching edges do not hit.\"\"\"\n\nfrom units import BIRD_X, BIRD_W, BIRD_H, PIPE_W, GAP_H\n\n\ndef rect_overlap(a0, a1, b0, b1):\n    \"\"\"True iff the half-open intervals [a0,a1) and [b0,b1) overlap.\"\"\"\n    return a0 < b1 and b0 < a1\n\n\ndef pipe_hit(y, pipe):\n    \"\"\"True if the bird at height y hits the given pipe.\n\n    The bird occupies [BIRD_X, BIRD_X+BIRD_W) x [y, y+BIRD_H). A pipe at x\n    occupies [x, x+PIPE_W); its open gap is [gap_top, gap_top+GAP_H).\n    \"\"\"\n    horizontal = rect_overlap(BIRD_X, BIRD_X + BIRD_W,\n                              pipe[\"x\"], pipe[\"x\"] + PIPE_W)\n    outside = y < pipe[\"gap_top\"] or y + BIRD_H > pipe[\"gap_top\"] + GAP_H\n    return horizontal and outside\n"}