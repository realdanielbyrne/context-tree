{"path":"test_flapsim.py","content":"\"\"\"Stdlib unittest suite for flapsim (physics, LCG, AABB, scoring, order).\"\"\"\n\nimport unittest\nfrom units import G, FLAP_V, VY_MAX, FIELD_H, BIRD_H, BIRD_X, PIPE_W, GAP_H\nfrom physics import step_bird\nfrom world import lcg, spawn, scroll, cull\nfrom collide import rect_overlap, pipe_hit\nfrom engine import run\n\n\nclass TestPhysics(unittest.TestCase):\n    def test_gravity_adds_and_flap_sets(self):\n        y, vy, alive = step_bird(560, 0, False)\n        self.assertEqual((y, vy, alive), (578, G, True))\n        y, vy, alive = step_bird(560, 100, True)\n        self.assertEqual((y, vy, alive), (533, FLAP_V, True))\n\n    def test_vy_max_clamps_gravity_only(self):\n        # gravity path clamps at VY_MAX\n        y, vy, alive = step_bird(100, VY_MAX + 50, False)\n        self.assertEqual(vy, VY_MAX)\n        # a flap is never clamped even if it would exceed the clamp\n        y, vy, alive = step_bird(100, VY_MAX, True)\n        self.assertEqual(vy, FLAP_V)\n\n    def test_ceiling_is_soft(self):\n        y, vy, alive = step_bird(-5, 0, False)\n        self.assertEqual((y, vy, alive), (0, 0, True))\n\n    def test_floor_kills_and_clamps_y(self):\n        y, vy, alive = step_bird(FIELD_H - 10, 100, False)\n        self.assertFalse(alive)\n        self.assertEqual(y, FIELD_H - BIRD_H)\n        self.assertNotEqual(vy, 0)  # floor does not zero vy\n\n\nclass TestLcg(unittest.TestCase):\n    def test_lcg_formula(self):\n        self.assertEqual(lcg(7), (1103515245 * 7 + 12345) % 2147483648)\n\n    def test_spawn_advances_once_and_gap_range(self):\n        s, pipe = spawn(0, 7)\n        self.assertEqual(s, lcg(7))\n        self.assertTrue(40 <= pipe[\"gap_top\"] < 120)\n        self.assertEqual(pipe[\"x\"], 2000)\n        self.assertFalse(pipe[\"passed\"])\n\n    def test_non_spawn_tick_is_noop(self):\n        s, pipe = spawn(1, 7)\n        self.assertIsNone(pipe)\n        self.assertEqual(s, 7)\n\n\nclass TestAabb(unittest.TestCase):\n    def test_touching_edges_do_not_overlap(self):\n        self.assertFalse(rect_overlap(0, 10, 10, 20))\n        self.assertFalse(rect_overlap(10, 20, 0, 10))\n\n    def test_overlap_and_disjoint(self):\n        self.assertTrue(rect_overlap(0, 10, 5, 15))\n        self.assertFalse(rect_overlap(0, 10, 20, 30))\n\n    def test_pipe_hit_gap_boundaries(self):\n        pipe = {\"x\": BIRD_X, \"gap_top\": 400, \"passed\": False}\n        # bottom exactly at gap bottom -> inside the gap, survives\n        self.assertFalse(pipe_hit(400 + GAP_H - BIRD_H, pipe))\n        # one centi-unit below the gap bottom -> hit\n        self.assertTrue(pipe_hit(400 + GAP_H - BIRD_H + 1, pipe))\n        # top exactly at gap top -> inside; one above -> hit\n        self.assertFalse(pipe_hit(400, pipe))\n        self.assertTrue(pipe_hit(399, pipe))\n\n    def test_pipe_right_edge_at_bird_x_no_overlap(self):\n        pipe = {\"x\": BIRD_X - PIPE_W, \"gap_top\": 0, \"passed\": False}\n        self.assertFalse(pipe_hit(560, pipe))\n\n\nclass TestScoring(unittest.TestCase):\n    def test_clean_glide_bonus(self):\n        # seed 7, flaps 0010: bird passes pipes with |vy| <= GLIDE_VY often\n        st, _ = run(7, 200, \"0010\")\n        self.assertEqual(st[\"score\"], 8)\n\n    def test_pipe_scored_once(self):\n        # a long run must never double-count: score stays bounded and alive\n        st, _ = run(3, 200, \"0001\")\n        self.assertEqual(st[\"score\"], 8)\n        self.assertTrue(st[\"alive\"])\n\n\nclass TestTickOrder(unittest.TestCase):\n    def test_ticks_run_includes_fatal_tick(self):\n        st, _ = run(7, 120, \"01\")\n        self.assertFalse(st[\"alive\"])\n        self.assertGreaterEqual(st[\"ticks_run\"], 1)\n        self.assertLessEqual(st[\"ticks_run\"], 120)\n\n    def test_floor_kill_scores_nothing_that_tick(self):\n        # seed 2, no flaps: bird falls to the floor; score must stay 0\n        st, _ = run(2, 90, \"0\")\n        self.assertFalse(st[\"alive\"])\n        self.assertEqual(st[\"score\"], 0)\n\n    def test_scroll_before_collision(self):\n        # a pipe spawned at t=0 reaches the bird only after scrolling;\n        # with flaps \"1\" (always flap) seed 11 dies within 60 ticks\n        st, _ = run(11, 60, \"1\")\n        self.assertFalse(st[\"alive\"])\n        self.assertEqual(st[\"score\"], 0)\n\n    def test_cull_after_scoring(self):\n        # culling before scoring would drop pipes at the exact boundary;\n        # a full 200-tick run still scores exactly 8 for seed 7\n        st, _ = run(7, 200, \"0010\")\n        self.assertEqual(st[\"score\"], 8)\n\n    def test_scroll_and_cull_mechanics(self):\n        pipes = [{\"x\": 100, \"gap_top\": 40, \"passed\": False}]\n        scroll(pipes)\n        self.assertEqual(pipes[0][\"x\"], 60)\n        self.assertEqual(cull([{\"x\": -PIPE_W, \"gap_top\": 0, \"passed\": True}]), [])\n        self.assertEqual(len(cull([{\"x\": -PIPE_W + 1, \"gap_top\": 0,\n                                    \"passed\": True}])), 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}