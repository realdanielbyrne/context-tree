import units, physics, world, collide

assert physics.step_bird(-5, -27, True) == (0, 0, True)
assert physics.step_bird(0, 0, False) == (18, 18, True)
assert physics.step_bird(100, 260, True) == (73, -27, True)
assert physics.step_bird(100, 255, False) == (360, 260, True)
assert physics.step_bird(1199, 18, False) == (1120, 36, False)

assert world.lcg(42) == (1103515245 * 42 + 12345) % 2147483648
p, s = world.spawn(45, 42)
assert p == {"x": 2000, "gap_top": 40 + (s >> 8) % 80, "passed": False}
assert world.spawn(46, s) == (None, s)

pipes = [{"x": 100}, {"x": -50}]
world.scroll(pipes)
assert [p["x"] for p in pipes] == [60, -90]
assert world.cull([{"x": -120}, {"x": -119}]) == [{"x": -119}]

assert collide.rect_overlap(300, 380, 380, 500) is False     # touching edges: no overlap
assert collide.rect_overlap(300, 380, 300, 420) is True
# gap [920, 1920): bird bottom exactly at 1920 is inside; one centi below hits
assert collide.pipe_hit(1840, {"x": 300, "gap_top": 920}) is False
assert collide.pipe_hit(1841, {"x": 300, "gap_top": 920}) is True
assert collide.pipe_hit(500, {"x": 220, "gap_top": 40}) is False    # right edge exactly BIRD_X
print("all checks passed")
EOF
