import units, physics, world, collide

# no floats anywhere
for m in (units, physics, world, collide):
    src = open(m.__file__).read()
    assert 'float' not in src and '.' not in ''.join(l for l in src.splitlines() if not l.startswith('from')), m.__name__

# physics sanity
assert physics.step_bird(560, 0, False) == (578, 18, True)
assert physics.step_bird(560, 0, True) == (533, -27, True)
assert physics.step_bird(-10, 5, False)[0:2] == (0, 0)
y, vy, alive = physics.step_bird(1200 - 80 + 5, 260, False)
assert (y, vy, alive) == (1120, 260, False), (y, vy, alive)

# world sanity
s = world.lcg(42)
assert s == (1103515245*42 + 12345) % 2147483648
p, s2 = world.spawn(0, 42)
assert p['x'] == 2000 and 40 <= p['gap_top'] < 120 and p['passed'] is False
assert world.spawn(1, 42) == (None, 42)
pipes = [{'x': 100}, {'x': -130}]
world.scroll(pipes)
assert pipes[0]['x'] == 60 and pipes[1]['x'] == -170
assert world.cull(pipes) == [pipes[0]]

# collide boundary cases per spec
assert not collide.rect_overlap(0, 10, 10, 20)   # touching edges no
assert collide.rect_overlap(0, 10, 9, 20)
pipe = {'x': 380, 'gap_top': 40}                  # gap [40, 1040), bird x-range overlaps [380,500)
assert not collide.pipe_hit(40, pipe)             # top exactly at gap_top: inside
assert not collide.pipe_hit(960, pipe)            # bottom = 960+80 = 1040 = gap end: INSIDE, survives
assert collide.pipe_hit(39, pipe)                 # just above gap
assert collide.pipe_hit(961, pipe)                # bottom 1041 > 1040: hit
pipe2 = {'x': 220, 'gap_top': 40}                 # right edge exactly BIRD_X=300? x+PIPE_W=340 no; use x=180 -> [180,300)
pipe3 = {'x': 180, 'gap_top': 40}
assert not collide.pipe_hit(500, pipe3)           # right edge exactly BIRD_X: no overlap
print('all checks passed')
