{
  "name": "@context-tree/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Trace log, blob store, segmenter, tree store, summarizer and prompt assembler for context-tree",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
    "./prompts/*": "./src/prompts/*"
  },
  "files": ["dist", "src/prompts"],
  "scripts": { "build": "tsc --build", "clean": "tsc --build --clean" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^13.0.3",
    "openai": "^7.8.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.25.1",
    "ulid": "^3.0.2"
  },
  "optionalDependencies": {
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
