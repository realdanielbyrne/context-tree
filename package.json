{
  "name": "context-tree-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monorepo root for @context-tree/{core,mcp,cli}",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build packages/core packages/mcp packages/cli eval",
    "clean": "tsc --build --clean packages/core packages/mcp packages/cli",
    "typecheck": "tsc --build packages/core packages/mcp packages/cli && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
